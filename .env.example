# Copy to .env and fill in real values. Never commit .env.

RAILS_ENV=development
RAILS_MASTER_KEY=
SECRET_KEY_BASE=
RAILS_SERVE_STATIC_FILES=true

# Database (Docker / production)
POSTGRES_DB=xboltmedia
DB_USERNAME=xboltmedia
DB_PASSWORD=
DATABASE_URL=

# Admin seed password (required in production seeds)
ADMIN_PASSWORD=

# Active Storage (S3-compatible)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
AWS_BUCKET=xbolt-assets

# Cloudflare R2 image uploads (ImageUploadService)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-<id>.r2.dev
R2_REGION=auto

# Optional: dedicated Active Record encryption keys (recommended in production)
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Optional: analytics IP hashing pepper (defaults to SECRET_KEY_BASE)
# IP_HASH_PEPPER=

# Shared cache / rate limits (recommended in production)
# REDIS_URL=redis://localhost:6379/0

# Mail
GMAIL_USERNAME=
GMAIL_PASSWORD=

# Tenant contact form reCAPTCHA
TENANT_RECAPTCHA_SITE_KEY=
TENANT_RECAPTCHA_SECRET_KEY=
TENANT_RECAPTCHA_MIN_SCORE=0.5

# Future payments (do not commit live keys)
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
