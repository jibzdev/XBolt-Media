<% content_for :page_title, "Change Password" %>
<% content_for :page_description, "Update your account password securely" %>

<div class="max-w-2xl">
  <div class="bg-white rounded-xl border border-zinc-200/70 p-5 xb-card-hover">
    <div class="flex items-center gap-2 mb-1">
      <i data-lucide="lock" class="w-4 h-4 text-zinc-400"></i>
      <h2 class="text-[13px] font-medium text-zinc-700">Change your password</h2>
    </div>
    <p class="text-[12px] text-zinc-400 mb-5">Use your current password to confirm this change.</p>

    <%= form_with url: password_admin_account_path, method: :patch, local: true, class: "space-y-4" do %>
      <div>
        <label for="current_password" class="block text-[13px] font-medium text-zinc-600 mb-1.5">Current password</label>
        <input
          id="current_password"
          name="current_password"
          type="password"
          required
          autocomplete="current-password"
          class="w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300 focus:border-zinc-300"
        >
      </div>

      <div>
        <label for="password" class="block text-[13px] font-medium text-zinc-600 mb-1.5">New password</label>
        <input
          id="password"
          name="password"
          type="password"
          required
          minlength="8"
          autocomplete="new-password"
          class="w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300 focus:border-zinc-300"
        >
      </div>

      <div>
        <label for="password_confirmation" class="block text-[13px] font-medium text-zinc-600 mb-1.5">Confirm new password</label>
        <input
          id="password_confirmation"
          name="password_confirmation"
          type="password"
          required
          minlength="8"
          autocomplete="new-password"
          class="w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300 focus:border-zinc-300"
        >
      </div>

      <div class="pt-2">
        <button type="submit" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-zinc-900 text-white text-[13px] font-medium hover:bg-zinc-800 transition">
          <i data-lucide="save" class="w-3.5 h-3.5"></i>
          Update password
        </button>
      </div>
    <% end %>
  </div>
</div>
