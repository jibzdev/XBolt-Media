<% content_for :page_title, "Assets" %>
<% content_for :page_description, "Use this to upload your images/videos etc" %>

<div class="space-y-4">
  <div class="bg-white rounded-xl border border-zinc-200/70 p-4 xb-card-hover">
    <div class="flex items-center gap-2 mb-3">
      <i data-lucide="upload" class="w-4 h-4 text-zinc-500"></i>
      <div>
        <h2 class="text-[13px] font-semibold text-zinc-800">Upload Assets</h2>
        <p class="text-[12px] text-zinc-500">Upload images or videos to your media library.</p>
      </div>
    </div>

    <%= form_with model: @business, url: admin_assets_path, method: :post, local: true, html: { multipart: true }, class: "space-y-3" do |f| %>
      <div>
        <%= f.file_field :assets,
          multiple: true,
          direct_upload: false,
          accept: "image/*,video/*",
          class: "block w-full text-[12px] text-zinc-600 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:bg-zinc-900 file:text-white file:text-[12px] file:font-medium hover:file:bg-zinc-800 file:cursor-pointer" %>
        <p class="text-[11px] text-zinc-400 mt-1">Accepted: images and videos. You can select multiple files.</p>
      </div>
      <div>
        <%= f.label :upload_category, "Category for this upload", class: "block text-[13px] font-medium text-zinc-600 mb-1.5" %>
        <%= f.text_field :upload_category, placeholder: "e.g. kitchen, lofts, exteriors", class: "w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300" %>
        <p class="text-[11px] text-zinc-400 mt-1">Used by tenant gallery filters. Defaults to <span class="font-mono">general</span>.</p>
      </div>
      <%= f.submit "Upload", class: "px-3.5 py-2 rounded-lg bg-zinc-900 text-white text-[13px] font-medium hover:bg-zinc-800 transition cursor-pointer" %>
    <% end %>
  </div>

  <div class="bg-white rounded-xl border border-zinc-200/70 p-4 xb-card-hover">
    <div class="flex items-center justify-between mb-3">
      <div class="flex items-center gap-2">
        <i data-lucide="folder-open" class="w-4 h-4 text-zinc-500"></i>
        <h3 class="text-[13px] font-semibold text-zinc-800">Your Uploaded Assets</h3>
      </div>
      <div class="text-[12px] text-zinc-400"><%= @assets.count %> file<%= "s" if @assets.count != 1 %></div>
    </div>

    <% if @assets.any? %>
      <div class="space-y-3">
        <% @assets.each do |attachment| %>
          <% blob = attachment.blob %>
          <% short_url = media_asset_path(key: blob.key) %>
          <% xbolt_meta = blob.metadata.fetch("xbolt", {}) %>
          <% asset_title = xbolt_meta.is_a?(Hash) ? xbolt_meta["title"].to_s.strip : "" %>
          <% asset_title = blob.filename.base if asset_title.blank? %>
          <% asset_category = xbolt_meta.is_a?(Hash) ? xbolt_meta["category"].to_s.strip : "" %>
          <% asset_category = "general" if asset_category.blank? %>
          <div class="border border-zinc-200/70 rounded-lg p-3.5 xb-card-hover">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <p class="text-[13px] font-medium text-zinc-800 truncate"><%= asset_title %></p>
                <p class="text-[11px] text-zinc-400 mt-0.5">
                  <%= blob.content_type.presence || "unknown" %> &middot;
                  <%= number_to_human_size(blob.byte_size) %> &middot;
                  category: <span class="font-mono"><%= asset_category %></span> &middot;
                  uploaded <%= time_ago_in_words(attachment.created_at) %> ago
                </p>
                <p class="text-[11px] text-zinc-400 mt-0.5 break-all"><%= short_url %></p>
              </div>
              <div class="flex items-center gap-1.5 flex-shrink-0">
                <%= link_to "Open", short_url, target: "_blank", rel: "noopener", class: "px-2.5 py-1 rounded-md border border-zinc-200/70 text-zinc-600 text-[11px] font-medium hover:bg-zinc-50 transition" %>
                <%= button_to "Delete",
                  admin_asset_path(attachment),
                  method: :delete,
                  form: { data: { turbo_confirm: "Delete this asset?" } },
                  class: "px-2.5 py-1 rounded-md bg-red-50 text-red-600 border border-red-200/70 text-[11px] font-medium hover:bg-red-100 transition" %>
              </div>
            </div>

            <% if blob.content_type.to_s.start_with?("image/") %>
              <div class="mt-2.5">
                <img src="<%= short_url %>" alt="<%= blob.filename.to_s %>" class="max-h-40 rounded-lg border border-zinc-200/70 object-contain bg-zinc-50">
              </div>
            <% elsif blob.content_type.to_s.start_with?("video/") %>
              <div class="mt-2.5">
                <video controls preload="metadata" class="w-full max-h-56 rounded-lg border border-zinc-200/70 bg-black">
                  <source src="<%= short_url %>" type="<%= blob.content_type %>">
                </video>
              </div>
            <% end %>

            <div class="mt-3 border-t border-zinc-200/70 pt-3">
              <%= form_with url: admin_asset_path(attachment), method: :patch, local: true, class: "grid grid-cols-1 md:grid-cols-3 gap-2" do |f| %>
                <%= f.text_field :title, value: asset_title, name: "asset[title]", placeholder: "Display title", class: "px-3 py-1.5 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300" %>
                <%= f.text_field :category, value: asset_category, name: "asset[category]", placeholder: "Category", class: "px-3 py-1.5 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300 font-mono" %>
                <%= f.submit "Save", class: "px-3 py-1.5 rounded-lg bg-zinc-900 text-white text-[13px] font-medium hover:bg-zinc-800 transition cursor-pointer" %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="rounded-lg border border-dashed border-zinc-300 bg-zinc-50 p-5 text-center">
        <div class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-zinc-100 mb-2">
          <i data-lucide="upload" class="w-4 h-4 text-zinc-400"></i>
        </div>
        <p class="text-[13px] font-medium text-zinc-600">No assets uploaded yet</p>
        <p class="text-[12px] text-zinc-400 mt-0.5">Upload images or videos to start building your media library.</p>
      </div>
    <% end %>
  </div>
</div>
