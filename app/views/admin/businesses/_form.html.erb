<%= form_with model: business, url: url, method: method, local: true, class: "space-y-5" do |f| %>
  <% if business.errors.any? %>
    <div class="p-3.5 rounded-lg bg-red-50 border border-red-200">
      <div class="text-[13px] font-semibold text-red-800 mb-1.5">Please fix the following:</div>
      <ul class="list-disc list-inside text-[12px] text-red-700 space-y-0.5">
        <% business.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <label class="block text-[13px] font-medium text-zinc-600 mb-1.5">Name</label>
    <%= f.text_field :name, class: "w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300 transition" %>
  </div>

  <div>
    <label class="block text-[13px] font-medium text-zinc-600 mb-1.5">Subdomain</label>
    <div class="flex flex-col sm:flex-row gap-2 items-stretch">
      <%= f.text_field :subdomain, placeholder: "clientname", class: "flex-1 px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white font-mono focus:outline-none focus:ring-1 focus:ring-zinc-300 transition" %>
      <div class="px-3 py-2 rounded-lg border border-zinc-100 bg-zinc-50/50 font-mono text-[13px] text-zinc-400">
        .<%= (GeneralSetting.first_or_initialize.website_url.presence || Rails.application.routes.default_url_options[:host] || 'xboltmedia.com').to_s.sub(%r{\Ahttps?://}i,'').split('/').first %>
      </div>
    </div>
    <p class="text-[11px] text-zinc-400 mt-1.5">Lowercase letters/numbers and hyphens only.</p>
  </div>

  <div>
    <label class="block text-[13px] font-medium text-zinc-600 mb-1.5">Custom domain (optional)</label>
    <%= f.text_field :custom_domain, placeholder: "www.client.com", class: "w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white font-mono focus:outline-none focus:ring-1 focus:ring-zinc-300 transition" %>
    <p class="text-[11px] text-zinc-400 mt-1.5">You can add it now or later; we'll show DNS instructions on the business page.</p>
  </div>

  <div>
    <label class="block text-[13px] font-medium text-zinc-600 mb-1.5">Project description</label>
    <%= f.text_area :description, rows: 4, placeholder: "Short description shown on the Work page…", class: "w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300 transition" %>
    <p class="text-[11px] text-zinc-400 mt-1.5">Keep it concise (this is what visitors will read).</p>
  </div>

  <div>
    <div class="flex items-center justify-between gap-4 mb-1.5">
      <label class="block text-[13px] font-medium text-zinc-600">Project image</label>
      <span id="business-image-status" class="text-[11px] text-zinc-400"></span>
    </div>

    <%= f.hidden_field :image_url, id: "business_image_url" %>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
      <div class="rounded-lg border border-zinc-100 bg-zinc-50/50 p-3.5">
        <input id="business_image_file" type="file" accept="image/*" class="block w-full text-[12px] transition file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-[12px] file:font-medium file:bg-zinc-900 file:text-white file:cursor-pointer file:transition text-zinc-600">
        <p class="text-[11px] text-zinc-400 mt-1.5">Upload an image (recommended: 1200x800 or similar).</p>
      </div>

      <div class="rounded-lg border border-zinc-100 bg-zinc-50/50 p-3.5">
        <div class="text-[11px] font-semibold text-zinc-400 uppercase tracking-wider mb-1.5">Preview</div>
        <img
          id="business_image_preview"
          src="<%= business.image_url.presence || '' %>"
          alt=""
          class="w-full h-36 object-cover rounded-lg border border-zinc-200/70 <%= business.image_url.present? ? '' : 'hidden' %>"
        />
        <div id="business_image_empty" class="text-[12px] text-zinc-400 <%= business.image_url.present? ? 'hidden' : '' %>">
          No image yet.
        </div>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-between gap-4 rounded-lg border border-zinc-100 bg-zinc-50/50 p-3.5">
    <div>
      <div class="text-[13px] font-semibold text-zinc-700">Show on Work page</div>
      <div class="text-[11px] text-zinc-400 mt-0.5">Only "active" businesses will appear publicly.</div>
    </div>
    <label class="inline-flex items-center gap-2 select-none">
      <%= f.check_box :active, class: "w-4 h-4 rounded accent-zinc-900 transition" %>
      <span class="text-[13px] font-medium text-zinc-700">Active</span>
    </label>
  </div>

  <div class="flex gap-2.5">
    <%= link_to "Cancel", cancel_path, class: "px-3.5 py-2 rounded-lg border border-zinc-200/70 text-zinc-600 text-[13px] font-medium hover:bg-zinc-50 transition" %>
    <%= f.submit submit_label, class: "px-3.5 py-2 rounded-lg bg-zinc-900 text-white text-[13px] font-medium hover:bg-zinc-800 transition cursor-pointer" %>
  </div>
<% end %>

<script>
  (function() {
    const input = document.getElementById("business_image_file");
    if (!input) return;

    const status = document.getElementById("business-image-status");
    const hidden = document.getElementById("business_image_url");
    const preview = document.getElementById("business_image_preview");
    const empty = document.getElementById("business_image_empty");
    const csrf = document.querySelector('meta[name="csrf-token"]')?.getAttribute("content");

    function setStatus(text) {
      if (status) status.textContent = text || "";
    }

    input.addEventListener("change", async () => {
      const file = input.files && input.files[0];
      if (!file) return;

      setStatus("Uploading…");

      try {
        const fd = new FormData();
        fd.append("file", file);

        const res = await fetch("<%= upload_image_path %>", {
          method: "POST",
          headers: csrf ? { "X-CSRF-Token": csrf } : {},
          body: fd
        });

        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.url) throw new Error(data.error || "Upload failed");

        hidden.value = data.url;
        if (preview) {
          preview.src = data.url;
          preview.classList.remove("hidden");
        }
        if (empty) empty.classList.add("hidden");

        setStatus("Uploaded");
      } catch (e) {
        setStatus("Upload failed");
        console.error(e);
      }
    });
  })();
</script>
