<% content_for :page_title, "Live Activity" %>
<% content_for :page_description, "Real-time user and activity stream" %>

<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-5">
  <div class="flex items-center gap-2.5">
    <div class="inline-flex items-center gap-1.5 text-[11px] font-medium px-2 py-1 rounded-md bg-emerald-50 text-emerald-700">
      <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-pulse"></span>
      Live
    </div>
    <span class="text-[11px] text-zinc-400">Showing 20 per page</span>
  </div>
  <%= link_to admin_overview_path, class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-zinc-200/70 text-zinc-600 hover:bg-zinc-50 transition text-[12px] font-medium" do %>
    <i data-lucide="arrow-left" class="w-3 h-3"></i>
    Back to overview
  <% end %>
</div>

<div class="grid grid-cols-4 gap-3 mb-5">
  <div class="bg-white rounded-xl border border-zinc-200/70 px-3.5 py-2.5 flex items-center gap-2.5">
    <div class="w-7 h-7 rounded-lg bg-emerald-50 flex items-center justify-center flex-shrink-0">
      <i data-lucide="radio" class="w-3.5 h-3.5 text-emerald-600"></i>
    </div>
    <div>
      <div class="text-[15px] font-bold text-zinc-800 leading-tight"><%= @online_users %></div>
      <div class="text-[10px] text-zinc-400 uppercase tracking-wider font-medium">Online</div>
    </div>
  </div>
  <div class="bg-white rounded-xl border border-zinc-200/70 px-3.5 py-2.5 flex items-center gap-2.5">
    <div class="w-7 h-7 rounded-lg bg-zinc-50 border border-zinc-200/70 flex items-center justify-center flex-shrink-0">
      <i data-lucide="users" class="w-3.5 h-3.5 text-blue-600"></i>
    </div>
    <div>
      <div class="text-[15px] font-bold text-zinc-800 leading-tight"><%= number_with_delimiter(@total_users) %></div>
      <div class="text-[10px] text-zinc-400 uppercase tracking-wider font-medium">Total</div>
    </div>
  </div>
  <div class="bg-white rounded-xl border border-zinc-200/70 px-3.5 py-2.5 flex items-center gap-2.5">
    <div class="w-7 h-7 rounded-lg bg-violet-50 flex items-center justify-center flex-shrink-0">
      <i data-lucide="user-plus" class="w-3.5 h-3.5 text-violet-600"></i>
    </div>
    <div>
      <div class="text-[15px] font-bold text-zinc-800 leading-tight"><%= @new_users_today %></div>
      <div class="text-[10px] text-zinc-400 uppercase tracking-wider font-medium">New today</div>
    </div>
  </div>
  <div class="bg-white rounded-xl border border-zinc-200/70 px-3.5 py-2.5 flex items-center gap-2.5">
    <div class="w-7 h-7 rounded-lg bg-amber-50 flex items-center justify-center flex-shrink-0">
      <i data-lucide="activity" class="w-3.5 h-3.5 text-amber-600"></i>
    </div>
    <div>
      <div class="text-[15px] font-bold text-zinc-800 leading-tight"><%= number_with_delimiter(@activities_today) %></div>
      <div class="text-[10px] text-zinc-400 uppercase tracking-wider font-medium">Events</div>
    </div>
  </div>
</div>

<div class="bg-white rounded-xl border border-zinc-200/70 overflow-hidden">
  <% if @recent_activities.any? %>
    <div class="hidden sm:grid sm:grid-cols-[36px_1fr_2fr_130px] gap-3 px-4 py-2.5 bg-zinc-50 border-b border-zinc-200/70 text-[11px] text-zinc-400 uppercase tracking-wider font-medium">
      <div></div>
      <div>User</div>
      <div>Event</div>
      <div class="text-right">Time</div>
    </div>

    <div class="divide-y divide-zinc-100">
      <% @recent_activities.each do |activity| %>
        <div class="grid grid-cols-1 sm:grid-cols-[36px_1fr_2fr_130px] gap-2 sm:gap-3 items-center px-4 py-2.5 hover:bg-zinc-50/60 transition-colors xb-row-hover">
          <div class="hidden sm:flex">
            <div class="w-6 h-6 rounded-full bg-zinc-900 flex items-center justify-center">
              <span class="text-[9px] font-bold text-white"><%= activity.user&.username&.first&.upcase || '?' %></span>
            </div>
          </div>
          <div class="text-[13px] font-medium text-zinc-700 truncate">
            @<%= activity.user&.username || 'unknown' %>
          </div>
          <div class="text-[13px] text-zinc-500 truncate"><%= activity.description %></div>
          <div class="text-[11px] text-zinc-400 tabular-nums sm:text-right">
            <time datetime="<%= activity.created_at.iso8601 %>"><%= time_ago_in_words(activity.created_at) %> ago</time>
          </div>
        </div>
      <% end %>
    </div>

    <div class="px-4 py-2.5 border-t border-zinc-200/70 bg-zinc-50/50">
      <%= paginate @recent_activities %>
    </div>
  <% else %>
    <div class="px-4 py-12 text-center">
      <div class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-zinc-100 mb-2">
        <i data-lucide="activity" class="w-4 h-4 text-zinc-400"></i>
      </div>
      <h3 class="text-[13px] font-medium text-zinc-700 mb-0.5">No activity yet</h3>
      <p class="text-[12px] text-zinc-400">Events will appear here as users interact with the platform.</p>
    </div>
  <% end %>
</div>
