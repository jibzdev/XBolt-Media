<%= form_with model: [:admin, @invoice], local: true, class: "space-y-5" do |f| %>
  <% if @invoice.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 p-3 text-[13px] text-red-600">
      <div class="flex items-center gap-1.5 font-medium mb-1">
        <i data-lucide="alert-circle" class="w-3.5 h-3.5"></i>
        <span>Please fix the following:</span>
      </div>
      <ul class="list-disc ml-5 space-y-0.5">
        <% @invoice.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
    <div>
      <%= f.label :business_id, "Business", class: "block text-[13px] font-medium text-zinc-600 mb-1.5" %>
      <%= f.collection_select :business_id, Business.order(:name), :id, :name, { prompt: "Select business" }, class: "w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300" %>
    </div>

    <div>
      <%= f.label :status, class: "block text-[13px] font-medium text-zinc-600 mb-1.5" %>
      <%= f.select :status, Invoice::STATUSES.map { |s| [s.titleize, s] }, {}, class: "w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300" %>
    </div>

    <div>
      <%= f.label :issue_date, class: "block text-[13px] font-medium text-zinc-600 mb-1.5" %>
      <%= f.date_field :issue_date, class: "w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300" %>
    </div>

    <div>
      <%= f.label :due_date, class: "block text-[13px] font-medium text-zinc-600 mb-1.5" %>
      <%= f.date_field :due_date, class: "w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300" %>
    </div>
  </div>

  <div class="bg-zinc-50 rounded-xl border border-zinc-200/70 p-4">
    <div class="flex items-center justify-between mb-3">
      <h3 class="text-[13px] font-medium text-zinc-700">Invoice items</h3>
      <button type="button" id="add-invoice-item" class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg bg-zinc-900 text-white text-[12px] font-medium hover:bg-zinc-800 transition">
        <i data-lucide="plus" class="w-3 h-3"></i>
        <span>Add item</span>
      </button>
    </div>

    <div id="invoice-items" class="space-y-2">
      <% (@invoice.line_items.presence || []).each do |item| %>
        <div class="grid grid-cols-12 gap-2 items-center invoice-item-row">
          <div class="col-span-12 md:col-span-5">
            <input type="text" name="invoice[line_items][][description]" value="<%= item['description'] %>" placeholder="Description (e.g. Website cost)" class="w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300" />
          </div>
          <div class="col-span-6 md:col-span-2">
            <select name="invoice[line_items][][billing_type]" class="w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300">
              <option value="one_time" <%= item['billing_type'] != 'monthly' ? 'selected' : '' %>>One-time</option>
              <option value="monthly" <%= item['billing_type'] == 'monthly' ? 'selected' : '' %>>Monthly</option>
            </select>
          </div>
          <div class="col-span-6 md:col-span-2">
            <input type="number" step="0.01" min="0" name="invoice[line_items][][quantity]" value="<%= item['quantity'] %>" placeholder="Qty" class="w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300" />
          </div>
          <div class="col-span-6 md:col-span-2">
            <input type="number" step="0.01" min="0" name="invoice[line_items][][unit_price]" value="<%= item['unit_price'] %>" placeholder="Unit price" class="w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300" />
          </div>
          <div class="col-span-12 md:col-span-1 text-right">
            <button type="button" class="remove-invoice-item p-1.5 rounded-lg border border-zinc-200/70 text-zinc-400 hover:text-red-500 hover:border-red-200 transition">
              <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
            </button>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div>
    <%= f.label :notes, class: "block text-[13px] font-medium text-zinc-600 mb-1.5" %>
    <%= f.text_area :notes, rows: 3, class: "w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300", placeholder: "Optional notes for the client" %>
  </div>

  <div class="flex items-center gap-2">
    <%= link_to admin_invoices_path, class: "inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg border border-zinc-200/70 text-zinc-600 text-[13px] font-medium hover:bg-zinc-50 transition" do %>
      <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
      <span>Cancel</span>
    <% end %>
    <%= f.submit(@invoice.persisted? ? "Update invoice" : "Create invoice", class: "px-3.5 py-2 rounded-lg bg-zinc-900 text-white text-[13px] font-medium hover:bg-zinc-800 transition cursor-pointer") %>
  </div>
<% end %>

<script>
  function initInvoiceItemsForm() {
    const items = document.getElementById('invoice-items');
    const addBtn = document.getElementById('add-invoice-item');
    if (!items || !addBtn) return;
    if (addBtn.dataset.invoiceItemsBound === 'true') return;
    addBtn.dataset.invoiceItemsBound = 'true';

    function bindRemove(button) {
      button.addEventListener('click', () => {
        button.closest('.invoice-item-row')?.remove();
      });
    }

    items.querySelectorAll('.remove-invoice-item').forEach(bindRemove);

    addBtn.addEventListener('click', () => {
      const row = document.createElement('div');
      row.className = 'grid grid-cols-12 gap-2 items-center invoice-item-row';
      row.innerHTML = `
        <div class="col-span-12 md:col-span-5">
          <input type="text" name="invoice[line_items][][description]" placeholder="Description" class="w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300" />
        </div>
        <div class="col-span-6 md:col-span-2">
          <select name="invoice[line_items][][billing_type]" class="w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300">
            <option value="one_time" selected>One-time</option>
            <option value="monthly">Monthly</option>
          </select>
        </div>
        <div class="col-span-6 md:col-span-2">
          <input type="number" step="0.01" min="0" name="invoice[line_items][][quantity]" value="1" placeholder="Qty" class="w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300" />
        </div>
        <div class="col-span-6 md:col-span-2">
          <input type="number" step="0.01" min="0" name="invoice[line_items][][unit_price]" value="0" placeholder="Unit price" class="w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300" />
        </div>
        <div class="col-span-12 md:col-span-1 text-right">
          <button type="button" class="remove-invoice-item p-1.5 rounded-lg border border-zinc-200/70 text-zinc-400 hover:text-red-500 hover:border-red-200 transition">
            <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
          </button>
        </div>
      `;
      items.appendChild(row);
      const removeBtn = row.querySelector('.remove-invoice-item');
      if (removeBtn) bindRemove(removeBtn);
      if (window.lucide) lucide.createIcons({ nodes: [row] });
    });
  }

  document.addEventListener('DOMContentLoaded', initInvoiceItemsForm);
  document.addEventListener('turbo:load', initInvoiceItemsForm);
</script>
