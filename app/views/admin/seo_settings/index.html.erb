<% content_for :page_title, "SEO Settings" %>
<% content_for :page_description, "Manage search engine optimization settings for all pages" %>

<div class="flex items-center justify-between mb-5">
  <div></div>
  <div class="flex items-center gap-2">
    <%= link_to new_admin_seo_setting_path, class: "inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-zinc-900 text-white text-[13px] font-medium hover:bg-zinc-800 transition" do %>
      <i data-lucide="plus" class="w-3.5 h-3.5"></i>
      <span>New SEO Setting</span>
    <% end %>

    <%= button_to admin_initialize_seo_defaults_path, method: :post, class: "inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg border border-zinc-200/70 text-zinc-600 text-[13px] font-medium hover:bg-zinc-50 transition" do %>
      <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i>
      <span>Initialize Defaults</span>
    <% end %>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-3">
  <% @seo_settings.each do |seo_setting| %>
    <div class="bg-white rounded-xl border border-zinc-200/70 p-4 hover:border-zinc-300 transition">
      <div class="flex items-start justify-between mb-3">
        <div class="flex items-center gap-2.5 flex-1 min-w-0">
          <div class="w-8 h-8 rounded-lg bg-zinc-100 flex items-center justify-center flex-shrink-0">
            <i data-lucide="search" class="w-3.5 h-3.5 text-zinc-500"></i>
          </div>
          <div class="min-w-0">
            <h3 class="text-[13px] font-semibold text-zinc-800 capitalize truncate">
              <%= seo_setting.page_name.gsub('_', ' ') %>
            </h3>
            <p class="text-[12px] text-zinc-500 truncate">
              <%= seo_setting.title&.truncate(40) %>
            </p>
          </div>
        </div>
        <div class="flex items-center gap-1 flex-shrink-0 ml-2">
          <%= link_to edit_admin_seo_setting_path(seo_setting), class: "p-1.5 text-zinc-400 hover:text-zinc-700 hover:bg-zinc-100 rounded-md transition" do %>
            <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
          <% end %>
          <%= button_to admin_seo_setting_path(seo_setting), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this SEO setting?" }, class: "p-1.5 text-red-400 hover:text-red-600 hover:bg-red-50 rounded-md transition bg-transparent border-0", form: { style: "display: inline;" } do %>
            <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
          <% end %>
        </div>
      </div>

      <div class="space-y-2">
        <div>
          <p class="text-[11px] font-medium text-zinc-400 uppercase tracking-wider mb-0.5">Description</p>
          <p class="text-[13px] text-zinc-600 line-clamp-2">
            <%= seo_setting.description || "No description set" %>
          </p>
        </div>

        <div>
          <p class="text-[11px] font-medium text-zinc-400 uppercase tracking-wider mb-0.5">Keywords</p>
          <p class="text-[13px] text-zinc-600 line-clamp-1">
            <%= seo_setting.keywords || "No keywords set" %>
          </p>
        </div>
      </div>
    </div>
  <% end %>
</div>

<% if @seo_settings.empty? %>
  <div class="bg-white rounded-xl border border-zinc-200/70 p-12 text-center">
    <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-zinc-100 mb-4">
      <i data-lucide="search" class="w-5 h-5 text-zinc-400"></i>
    </div>
    <h3 class="text-[15px] font-semibold text-zinc-800 mb-1">No SEO settings yet</h3>
    <p class="text-[13px] text-zinc-500 mb-4">Initialize default settings or create custom ones.</p>
    <%= button_to "Initialize Defaults", admin_initialize_seo_defaults_path, method: :post, class: "inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-zinc-900 text-white text-[13px] font-medium hover:bg-zinc-800 transition" %>
  </div>
<% end %>
