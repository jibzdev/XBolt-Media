<% content_for :page_title, "Service Management" %>
<% content_for :page_description, "Create, edit, and manage your service offerings" %>

<div class="flex items-center justify-between mb-5">
  <div></div>
  <a href="<%= new_admin_service_path %>" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-zinc-900 text-white text-[13px] font-medium hover:bg-zinc-800 transition">
    <i data-lucide="plus" class="w-3.5 h-3.5"></i>
    <span>Add Service</span>
  </a>
</div>

<div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-5">
  <div class="bg-white rounded-xl border border-zinc-200/70 p-4 xb-card-hover xb-stat-card">
    <div class="flex items-center justify-between mb-3">
      <span class="text-[11px] text-zinc-400">Total Services</span>
      <i data-lucide="briefcase" class="w-3.5 h-3.5 text-zinc-300"></i>
    </div>
    <div class="text-[15px] font-semibold text-zinc-900 tabular-nums"><%= @services.count %></div>
  </div>

  <div class="bg-white rounded-xl border border-zinc-200/70 p-4 xb-card-hover xb-stat-card">
    <div class="flex items-center justify-between mb-3">
      <span class="text-[11px] text-zinc-400">Active</span>
      <i data-lucide="check-circle" class="w-3.5 h-3.5 text-zinc-300"></i>
    </div>
    <div class="text-[15px] font-semibold text-zinc-900 tabular-nums"><%= @services.select(&:active).count %></div>
  </div>

  <div class="bg-white rounded-xl border border-zinc-200/70 p-4 xb-card-hover xb-stat-card">
    <div class="flex items-center justify-between mb-3">
      <span class="text-[11px] text-zinc-400">Inactive</span>
      <i data-lucide="pause-circle" class="w-3.5 h-3.5 text-zinc-300"></i>
    </div>
    <div class="text-[15px] font-semibold text-zinc-900 tabular-nums"><%= @services.reject(&:active).count %></div>
  </div>

  <div class="bg-white rounded-xl border border-zinc-200/70 p-4 xb-card-hover xb-stat-card">
    <div class="flex items-center justify-between mb-3">
      <span class="text-[11px] text-zinc-400">Categories</span>
      <i data-lucide="tag" class="w-3.5 h-3.5 text-zinc-300"></i>
    </div>
    <div class="text-[15px] font-semibold text-zinc-900 tabular-nums"><%= @services.map(&:category).uniq.count %></div>
  </div>
</div>

<div class="bg-white rounded-xl border border-zinc-200/70 p-4 mb-4">
  <h3 class="text-[13px] font-medium text-zinc-700 mb-3">Filter Services</h3>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
    <div>
      <label class="block text-[13px] font-medium text-zinc-600 mb-1.5">Category</label>
      <select id="category-filter" class="w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300">
        <option value="">All Categories</option>
        <% Service.distinct.pluck(:category).each do |category| %>
          <option value="<%= category %>" <%= 'selected' if params[:category] == category %>><%= category %></option>
        <% end %>
      </select>
    </div>
    <div>
      <label class="block text-[13px] font-medium text-zinc-600 mb-1.5">Status</label>
      <select id="status-filter" class="w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300">
        <option value="">All Status</option>
        <option value="true" <%= 'selected' if params[:active] == 'true' %>>Active</option>
        <option value="false" <%= 'selected' if params[:active] == 'false' %>>Inactive</option>
      </select>
    </div>
  </div>
</div>

<div class="bg-white rounded-xl border border-zinc-200/70 overflow-hidden">
  <% if @services.any? %>
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead class="bg-zinc-50 border-b border-zinc-200/70">
          <tr>
            <th class="px-4 py-2.5 text-left text-[11px] font-medium text-zinc-400 uppercase tracking-wider">Service</th>
            <th class="px-4 py-2.5 text-left text-[11px] font-medium text-zinc-400 uppercase tracking-wider">Category</th>
            <th class="px-4 py-2.5 text-left text-[11px] font-medium text-zinc-400 uppercase tracking-wider">Price</th>
            <th class="px-4 py-2.5 text-left text-[11px] font-medium text-zinc-400 uppercase tracking-wider">Status</th>
            <th class="px-4 py-2.5 text-left text-[11px] font-medium text-zinc-400 uppercase tracking-wider">Position</th>
            <th class="px-4 py-2.5 text-left text-[11px] font-medium text-zinc-400 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-zinc-100" id="services-table">
          <% @services.each do |service| %>
            <tr class="hover:bg-zinc-50/60 transition-colors xb-row-hover" data-category="<%= service.category %>" data-status="<%= service.active %>">
              <td class="px-4 py-3">
                <div class="flex items-center gap-2.5">
                  <div class="w-7 h-7 bg-zinc-100 rounded-lg flex items-center justify-center flex-shrink-0">
                    <i data-lucide="wrench" class="w-3.5 h-3.5 text-zinc-500"></i>
                  </div>
                  <div>
                    <div class="text-[13px] font-medium text-zinc-800"><%= service.name %></div>
                    <% if service.description.present? %>
                      <div class="text-[12px] text-zinc-500 mt-0.5"><%= truncate(service.description, length: 50) %></div>
                    <% end %>
                  </div>
                </div>
              </td>
              <td class="px-4 py-3">
                <span class="px-2 py-0.5 rounded text-[11px] font-medium bg-zinc-100 text-zinc-600">
                  <%= service.category %>
                </span>
              </td>
              <td class="px-4 py-3">
                <div class="text-[13px] font-medium text-zinc-800"><%= number_to_currency(service.base_price) %></div>
              </td>
              <td class="px-4 py-3">
                <span class="px-2 py-0.5 rounded text-[11px] font-medium <%= service.active ? 'bg-emerald-50 text-emerald-700' : 'bg-zinc-100 text-zinc-500' %>">
                  <%= service.active ? 'Active' : 'Inactive' %>
                </span>
              </td>
              <td class="px-4 py-3">
                <div class="text-[13px] text-zinc-500"><%= service.position %></div>
              </td>
              <td class="px-4 py-3">
                <div class="flex items-center gap-1">
                  <a href="<%= edit_admin_service_path(service) %>" class="p-1.5 text-zinc-400 hover:text-zinc-700 hover:bg-zinc-100 rounded-md transition" title="Edit">
                    <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
                  </a>
                  <%= button_to admin_service_path(service), method: :delete,
                      data: { turbo_confirm: 'Are you sure you want to delete this service?' },
                      class: "p-1.5 text-red-400 hover:text-red-600 hover:bg-red-50 rounded-md transition bg-transparent border-0",
                      title: "Delete",
                      form: { style: 'display: inline;' } do %>
                      <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="text-center py-12">
      <div class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-zinc-100 mb-3">
        <i data-lucide="wrench" class="w-4 h-4 text-zinc-400"></i>
      </div>
      <h3 class="text-[13px] font-semibold text-zinc-800 mb-1">No services yet</h3>
      <p class="text-[12px] text-zinc-500">Create your first service to get started.</p>
    </div>
  <% end %>
</div>
