<% content_for :page_title, 'New Service' %>
<% content_for :page_description, 'Create a new service offering' %>

<div class="flex items-center justify-between mb-5">
  <div class="flex items-center gap-2.5">
    <i data-lucide="wrench" class="w-4 h-4 text-zinc-500"></i>
    <div>
      <h1 class="text-[15px] font-semibold text-zinc-800">New Service</h1>
      <p class="text-[12px] text-zinc-500">Add a new service offering</p>
    </div>
  </div>
  <a href="<%= admin_services_path %>" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg border border-zinc-200/70 text-zinc-600 text-[13px] font-medium hover:bg-zinc-50 transition">
    <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
    Back
  </a>
</div>

<div class="bg-white rounded-xl border border-zinc-200/70 p-5 xb-card-hover">
  <%= form_with model: [:admin, @service], local: true, class: "space-y-4" do |f| %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
      <div>
        <%= f.label :name, class: "block text-[13px] font-medium text-zinc-600 mb-1.5" %>
        <%= f.text_field :name, class: "w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300" %>
      </div>

      <div>
        <%= f.label :base_price, class: "block text-[13px] font-medium text-zinc-600 mb-1.5" %>
        <div class="relative">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-[13px] text-zinc-400">£</span>
          <%= f.number_field :base_price, step: 0.01, min: 0, class: "w-full pl-7 pr-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300" %>
        </div>
      </div>

      <div>
        <%= f.label :category, class: "block text-[13px] font-medium text-zinc-600 mb-1.5" %>
        <%= f.select :category, [['General', 'general'], ['Tinting', 'tinting'], ['Wrapping', 'wrapping'], ['Detailing', 'detailing'], ['Custom', 'custom']], {}, class: "w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300" %>
      </div>

      <div>
        <%= f.label :position, class: "block text-[13px] font-medium text-zinc-600 mb-1.5" %>
        <%= f.number_field :position, min: 1, class: "w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300" %>
      </div>

      <div class="md:col-span-2">
        <%= f.label :description, class: "block text-[13px] font-medium text-zinc-600 mb-1.5" %>
        <%= f.text_area :description, rows: 4, class: "w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300 resize-none" %>
      </div>

      <div class="md:col-span-2">
        <label class="flex items-center gap-2.5">
          <%= f.check_box :active, class: "h-4 w-4 rounded border-zinc-300 text-zinc-900 focus:ring-zinc-300" %>
          <div>
            <span class="text-[13px] font-medium text-zinc-800">Active</span>
            <p class="text-[12px] text-zinc-500">Make this service available for booking</p>
          </div>
        </label>
      </div>
    </div>

    <div class="flex justify-between gap-2 pt-3 border-t border-zinc-200/70">
      <a href="<%= admin_services_path %>" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg border border-zinc-200/70 text-zinc-600 text-[13px] font-medium hover:bg-zinc-50 transition">
        <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
        Back to Services
      </a>
      <%= f.submit "Create Service", class: "px-3.5 py-2 rounded-lg bg-zinc-900 text-white text-[13px] font-medium hover:bg-zinc-800 transition cursor-pointer" %>
    </div>
  <% end %>
</div>
