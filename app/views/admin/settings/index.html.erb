<% content_for :page_title, "Admin Settings" %>
<% content_for :page_description, "Configure your application settings and preferences" %>
<% active_tab = @active_tab.presence || "general" %>

<% if flash[:notice] %>
  <div class="mb-5 bg-emerald-50 border border-emerald-200/70 rounded-lg px-3.5 py-2.5">
    <div class="flex items-center gap-2 text-emerald-700">
      <i data-lucide="check-circle" class="w-3.5 h-3.5"></i>
      <span class="text-[13px] font-medium"><%= flash[:notice] %></span>
    </div>
  </div>
<% end %>

<% if flash[:alert] %>
  <div class="mb-5 bg-red-50 border border-red-200/70 rounded-lg px-3.5 py-2.5">
    <div class="flex items-center gap-2 text-red-600">
      <i data-lucide="alert-circle" class="w-3.5 h-3.5"></i>
      <span class="text-[13px] font-medium"><%= flash[:alert] %></span>
    </div>
  </div>
<% end %>

<div class="bg-white rounded-xl border border-zinc-200/70 overflow-hidden" data-settings-tabs>
  <div class="px-5 py-4 border-b border-zinc-200/70 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-center gap-2.5">
      <div class="w-8 h-8 bg-zinc-900 rounded-lg flex items-center justify-center">
        <i data-lucide="settings" class="w-4 h-4 text-white"></i>
      </div>
      <div>
        <h3 class="text-[15px] font-semibold text-zinc-800">General Settings</h3>
        <p class="text-[12px] text-zinc-500">Edit site details, branding, team, and FAQs</p>
      </div>
    </div>
  </div>

  <div class="px-5 pt-4 border-b border-zinc-200/70 overflow-x-auto">
    <div class="flex items-center gap-1 min-w-max" role="tablist" aria-label="Settings sections">
      <% [
        ["general", "General", "sliders-horizontal"],
        ["contact", "Contact", "phone"],
        ["social", "Social", "share-2"],
        ["branding", "Branding", "palette"],
        ["team", "Team", "users"],
        ["faq", "FAQ", "circle-help"]
      ].each do |key, label, icon| %>
        <button
          type="button"
          role="tab"
          data-settings-tab="<%= key %>"
          aria-selected="<%= active_tab == key %>"
          class="settings-tab inline-flex items-center gap-1.5 px-3 py-2.5 text-[13px] font-medium border-b-2 -mb-px transition <%= active_tab == key ? 'border-zinc-900 text-zinc-900' : 'border-transparent text-zinc-500 hover:text-zinc-800' %>"
        >
          <i data-lucide="<%= icon %>" class="w-3.5 h-3.5"></i>
          <%= label %>
        </button>
      <% end %>
    </div>
  </div>

  <div class="p-5">
    <%= form_with(model: @general_setting, url: admin_update_settings_path(tab: active_tab), method: :patch, local: true, class: "space-y-5", html: { id: "general-settings-form" }) do |f| %>
      <input type="hidden" name="tab" id="settings-active-tab" value="<%= active_tab %>">

      <div data-settings-panel="general" class="<%= active_tab == 'general' ? '' : 'hidden' %> space-y-4">
        <div>
          <h4 class="text-[13px] font-semibold text-zinc-800">Application</h4>
          <p class="text-[12px] text-zinc-500 mt-0.5">Core site identity and access controls.</p>
        </div>

        <div class="flex items-center justify-between px-3.5 py-3 rounded-lg bg-zinc-50 border border-zinc-200/70">
          <div>
            <h4 class="text-[13px] font-semibold text-zinc-800">Disable Logins/Registrations</h4>
            <p class="text-[12px] text-zinc-500 mt-0.5">Temporarily disable user access</p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <%= f.check_box :maintenance_mode, class: "sr-only peer", id: "maintenance_mode_toggle" %>
            <div class="w-9 h-5 bg-zinc-300 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-zinc-200 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-zinc-900"></div>
          </label>
        </div>

        <div>
          <%= f.label :application_name, "Application Name", class: "block text-[13px] font-medium text-zinc-600 mb-1.5" %>
          <%= f.text_field :application_name, class: "w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300" %>
        </div>
      </div>

      <div data-settings-panel="contact" class="<%= active_tab == 'contact' ? '' : 'hidden' %> space-y-4">
        <div>
          <h4 class="text-[13px] font-semibold text-zinc-800">Contact details</h4>
          <p class="text-[12px] text-zinc-500 mt-0.5">Shown in the footer and contact areas.</p>
        </div>

        <div>
          <%= f.label :phone_number, "Phone Number", class: "block text-[13px] font-medium text-zinc-600 mb-1.5" %>
          <%= f.text_field :phone_number, class: "w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300" %>
        </div>
        <div>
          <%= f.label :contact_email, "Contact Email", class: "block text-[13px] font-medium text-zinc-600 mb-1.5" %>
          <%= f.email_field :contact_email, class: "w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300" %>
        </div>
        <div>
          <%= f.label :website_url, "Website URL", class: "block text-[13px] font-medium text-zinc-600 mb-1.5" %>
          <%= f.url_field :website_url, class: "w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300" %>
        </div>
      </div>

      <div data-settings-panel="social" class="<%= active_tab == 'social' ? '' : 'hidden' %> space-y-4">
        <div>
          <h4 class="text-[13px] font-semibold text-zinc-800">Social & Reviews</h4>
          <p class="text-[12px] text-zinc-500 mt-0.5">Shown in the site footer and on the contact page. Leave blank to use defaults / hide.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <div>
            <%= f.label :linkedin_url, "LinkedIn URL", class: "block text-[13px] font-medium text-zinc-600 mb-1.5" %>
            <%= f.url_field :linkedin_url, placeholder: "https://www.linkedin.com/company/xbolt-media/", class: "w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300" %>
          </div>
          <div>
            <%= f.label :facebook_url, "Facebook URL", class: "block text-[13px] font-medium text-zinc-600 mb-1.5" %>
            <%= f.url_field :facebook_url, placeholder: "https://facebook.com/xboltmedia", class: "w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300" %>
          </div>
          <div>
            <%= f.label :instagram_url, "Instagram URL", class: "block text-[13px] font-medium text-zinc-600 mb-1.5" %>
            <%= f.url_field :instagram_url, placeholder: "https://instagram.com/xboltmedia", class: "w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300" %>
          </div>
          <div>
            <%= f.label :tiktok_url, "TikTok URL", class: "block text-[13px] font-medium text-zinc-600 mb-1.5" %>
            <%= f.url_field :tiktok_url, placeholder: "https://tiktok.com/@xboltmedia", class: "w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300" %>
          </div>
        </div>

        <div>
          <%= f.label :google_reviews_url, "Google Reviews URL", class: "block text-[13px] font-medium text-zinc-600 mb-1.5" %>
          <%= f.url_field :google_reviews_url, placeholder: "https://g.page/r/.../review", class: "w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300" %>
          <p class="text-[11px] text-zinc-400 mt-1">Adds “Read all reviews on Google” buttons to the reviews page.</p>
        </div>
      </div>

      <div data-settings-panel="branding" class="<%= active_tab == 'branding' ? '' : 'hidden' %> space-y-4">
        <div>
          <h4 class="text-[13px] font-semibold text-zinc-800">Branding</h4>
          <p class="text-[12px] text-zinc-500 mt-0.5">Logo + favicon used across the site and admin.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <div>
            <%= f.label :logo_url, "Logo URL", class: "block text-[13px] font-medium text-zinc-600 mb-1.5" %>
            <div class="flex items-center gap-2.5">
              <div class="w-11 h-11 rounded-lg border border-zinc-200/70 bg-white flex items-center justify-center overflow-hidden flex-shrink-0">
                <img id="xbolt-logo-preview" src="<%= brand_logo_url %>" alt="Logo preview" class="max-w-[36px] max-h-[26px] object-contain">
              </div>
              <div class="flex-1">
                <%= f.url_field :logo_url, placeholder: "https://.../logo.png", class: "w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300", data: { preview_target: "xbolt-logo-preview" } %>
                <p class="text-[11px] text-zinc-400 mt-1">Transparent PNG/SVG, ~200–400px wide.</p>
              </div>
            </div>
          </div>
          <div>
            <%= f.label :favicon_url, "Favicon / Mark URL", class: "block text-[13px] font-medium text-zinc-600 mb-1.5" %>
            <div class="flex items-center gap-2.5">
              <div class="w-11 h-11 rounded-lg border border-zinc-200/70 bg-white flex items-center justify-center overflow-hidden flex-shrink-0">
                <img id="xbolt-favicon-preview" src="<%= brand_favicon_url %>" alt="Favicon preview" class="w-6 h-6 object-contain">
              </div>
              <div class="flex-1">
                <%= f.url_field :favicon_url, placeholder: "https://.../favicon.png", class: "w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300", data: { preview_target: "xbolt-favicon-preview" } %>
                <p class="text-[11px] text-zinc-400 mt-1">Square PNG, 256×256.</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div data-settings-panel="team" class="<%= active_tab == 'team' ? '' : 'hidden' %> space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
          <div>
            <h4 class="text-[13px] font-semibold text-zinc-800">Meet the team</h4>
            <p class="text-[12px] text-zinc-500 mt-0.5">Powers the public <a href="<%= team_path %>" target="_blank" class="underline hover:text-zinc-800">/team</a> page. One person per line.</p>
          </div>
          <a href="<%= team_path %>" target="_blank" class="inline-flex items-center gap-1.5 text-[12px] font-medium text-zinc-600 hover:text-zinc-900">
            View page <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
          </a>
        </div>

        <div class="rounded-lg border border-zinc-200/70 bg-zinc-50 px-3.5 py-3 text-[12px] text-zinc-600">
          Format: <code class="text-[11px] bg-white border border-zinc-200 px-1.5 py-0.5 rounded">Name|Role|Bio|Initials</code>
          <div class="mt-1 text-zinc-500">Example: <span class="font-mono text-[11px]">Jibraeel|Founder|Leads product and delivery.|J</span></div>
        </div>

        <%= f.text_area :team_members_data,
              rows: 10,
              class: "w-full px-3 py-2.5 rounded-lg border border-zinc-200/70 text-[12px] font-mono text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300 leading-relaxed",
              placeholder: "Name|Role|Bio|Initials" %>
        <p class="text-[11px] text-zinc-400">Up to <%= GeneralSetting::MAX_TEAM_MEMBERS %> people. Leave blank to use the built-in defaults.</p>
      </div>

      <div data-settings-panel="faq" class="<%= active_tab == 'faq' ? '' : 'hidden' %> space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
          <div>
            <h4 class="text-[13px] font-semibold text-zinc-800">FAQ</h4>
            <p class="text-[12px] text-zinc-500 mt-0.5">Powers the homepage FAQ section and the public <a href="<%= faq_path %>" target="_blank" class="underline hover:text-zinc-800">/faq</a> page. One question per line.</p>
          </div>
          <a href="<%= faq_path %>" target="_blank" class="inline-flex items-center gap-1.5 text-[12px] font-medium text-zinc-600 hover:text-zinc-900">
            View page <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
          </a>
        </div>

        <div class="rounded-lg border border-zinc-200/70 bg-zinc-50 px-3.5 py-3 text-[12px] text-zinc-600">
          Format: <code class="text-[11px] bg-white border border-zinc-200 px-1.5 py-0.5 rounded">Question|Answer</code>
        </div>

        <%= f.text_area :faq_items_data,
              rows: 12,
              class: "w-full px-3 py-2.5 rounded-lg border border-zinc-200/70 text-[12px] font-mono text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300 leading-relaxed",
              placeholder: "Question|Answer" %>
        <p class="text-[11px] text-zinc-400">Up to <%= GeneralSetting::MAX_FAQ_ITEMS %> questions. The homepage shows the first 4.</p>
      </div>

      <div class="pt-2">
        <button type="submit" class="w-full px-3.5 py-2.5 rounded-lg bg-zinc-900 text-white text-[13px] font-medium hover:bg-zinc-800 transition inline-flex items-center justify-center gap-2">
          <i data-lucide="save" class="w-3.5 h-3.5"></i>
          Save Changes
        </button>
      </div>
    <% end %>
  </div>
</div>

<script>
  (function () {
    function initUrlPreviews() {
      document.querySelectorAll("input[data-preview-target]").forEach((input) => {
        const id = input.getAttribute("data-preview-target");
        const img = id ? document.getElementById(id) : null;
        if (!img) return;

        const update = () => {
          const v = (input.value || "").trim();
          if (v.length > 0) img.src = v;
        };
        input.addEventListener("input", update);
      });
    }

    function initSettingsTabs() {
      const root = document.querySelector("[data-settings-tabs]");
      if (!root || root.dataset.tabsReady === "1") return;
      root.dataset.tabsReady = "1";

      const tabs = Array.from(root.querySelectorAll("[data-settings-tab]"));
      const panels = Array.from(root.querySelectorAll("[data-settings-panel]"));
      const hidden = document.getElementById("settings-active-tab");
      const form = document.getElementById("general-settings-form");

      function activate(key) {
        tabs.forEach((tab) => {
          const on = tab.getAttribute("data-settings-tab") === key;
          tab.setAttribute("aria-selected", on ? "true" : "false");
          tab.classList.toggle("border-zinc-900", on);
          tab.classList.toggle("text-zinc-900", on);
          tab.classList.toggle("border-transparent", !on);
          tab.classList.toggle("text-zinc-500", !on);
        });
        panels.forEach((panel) => {
          panel.classList.toggle("hidden", panel.getAttribute("data-settings-panel") !== key);
        });
        if (hidden) hidden.value = key;
        if (form) form.action = form.action.replace(/([?&])tab=[^&]*/, "$1tab=" + encodeURIComponent(key));
        try {
          const url = new URL(window.location.href);
          url.searchParams.set("tab", key);
          window.history.replaceState({}, "", url.toString());
        } catch (_) {}
      }

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => activate(tab.getAttribute("data-settings-tab")));
      });
    }

    document.addEventListener("DOMContentLoaded", () => {
      initUrlPreviews();
      initSettingsTabs();
    });
    document.addEventListener("turbo:load", () => {
      initUrlPreviews();
      initSettingsTabs();
    });
  })();
</script>
