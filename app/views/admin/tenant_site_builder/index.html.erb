<% content_for :page_title, "Website Editor" %>
<% content_for :page_description, "Click text to edit and drag cards or sections to reorder" %>

<div
  id="tenant-builder"
  class="-m-5 sm:-m-6 h-[calc(100vh-52px)] grid grid-cols-1 xl:grid-cols-[340px_minmax(0,1fr)] bg-zinc-100"
  data-page-id="<%= @page.id %>"
  data-page-title="<%= @page.title %>"
  data-page-slug="<%= @page.slug %>"
  data-page-position="<%= @page.position %>"
  data-sections="<%= json_escape(@sections_json) %>"
  data-update-url="<%= admin_website_page_path(@page) %>"
  data-static-mode="<%= @static_deployed ? "true" : "false" %>"
  data-static-path="<%= @static_path %>"
  data-static-update-url="<%= admin_static_website_update_path %>"
  data-publish-url="<%= admin_publish_website_path %>"
  data-preview-url="<%= @static_deployed ? admin_static_website_preview_path(path: @static_path) : preview_admin_website_page_path(@page, editor: 1) %>"
  data-site-url="<%= business_site_url(@business) %>"
>
  <aside class="bg-white border-r border-zinc-200/70 flex flex-col min-h-0">
    <div class="p-4 border-b border-zinc-200/70">
      <div class="flex items-center justify-between gap-3">
        <div>
          <h2 class="text-[14px] font-semibold text-zinc-900">Website Editor</h2>
          <p class="text-[11px] text-zinc-500 mt-0.5">Select text on the site to edit it.</p>
        </div>
        <span id="tenant-builder-save-status" class="text-[11px] text-zinc-400">Saved</span>
      </div>

      <div class="mt-4">
        <label class="block text-[11px] font-medium text-zinc-500 mb-1.5">Page</label>
        <% if @static_deployed && @static_pages.any? %>
          <select
            id="tenant-builder-page-switcher"
            class="w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300"
          >
            <% @static_pages.each do |page| %>
              <option value="<%= admin_website_path(path: page[:path]) %>" <%= "selected" if page[:path] == @static_path %>>
                <%= page[:title] %> (<%= page[:path] %>)
              </option>
            <% end %>
          </select>
        <% else %>
          <select
            id="tenant-builder-page-switcher"
            class="w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300"
          >
            <% @pages.each do |page| %>
              <option value="<%= admin_website_path(page_id: page.id) %>" <%= "selected" if page.id == @page.id %>>
                <%= page.title %> (<%= page.slug %>)
              </option>
            <% end %>
          </select>
        <% end %>
      </div>
    </div>

    <div class="p-4 space-y-4 overflow-y-auto min-h-0 flex-1">
      <div class="rounded-xl border border-zinc-200/70 bg-zinc-50 p-3">
        <h3 class="text-[12px] font-semibold text-zinc-800 mb-1">How it works</h3>
        <p class="text-[12px] text-zinc-500 leading-relaxed">
          Click any highlighted text in the website preview, edit it here, and it saves automatically. Drag whole sections or card items inside the preview to reorder them.
        </p>
      </div>

      <div id="tenant-builder-empty-state" class="rounded-xl border border-dashed border-zinc-300 bg-white p-4 text-center">
        <div class="inline-flex w-9 h-9 items-center justify-center rounded-lg bg-zinc-100 mb-2">
          <i data-lucide="mouse-pointer-click" class="w-4 h-4 text-zinc-400"></i>
        </div>
        <p class="text-[13px] font-medium text-zinc-700">No text selected</p>
        <p class="text-[12px] text-zinc-400 mt-1">Click text in the website preview to edit it.</p>
      </div>

      <div id="tenant-builder-field-panel" class="hidden rounded-xl border border-zinc-200/70 bg-white p-4">
        <div class="flex items-center justify-between gap-3 mb-3">
          <div>
            <h3 id="tenant-builder-field-label" class="text-[13px] font-semibold text-zinc-800">Selected text</h3>
            <p id="tenant-builder-field-meta" class="text-[11px] text-zinc-400 mt-0.5">Section text</p>
          </div>
          <button id="tenant-builder-clear-selection" type="button" class="p-1.5 rounded-md text-zinc-400 hover:text-zinc-700 hover:bg-zinc-50">
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>

        <label class="block">
          <span class="block text-[11px] font-medium text-zinc-500 mb-1.5">Text</span>
          <textarea id="tenant-builder-text-input" rows="6" class="w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300"></textarea>
        </label>
      </div>

      <div class="rounded-xl border border-zinc-200/70 bg-white p-4">
        <h3 class="text-[13px] font-semibold text-zinc-800">Reordering</h3>
        <p class="text-[12px] text-zinc-500 mt-1 leading-relaxed">
          Drag highlighted sections up or down. Card, testimonial, and FAQ items can be dragged within their own group.
        </p>
      </div>
    </div>

    <div class="p-4 border-t border-zinc-200/70 space-y-2">
      <% unless @static_deployed %>
        <button id="tenant-builder-publish" type="button" class="w-full px-3.5 py-2 rounded-lg bg-zinc-900 text-white text-[13px] font-medium hover:bg-zinc-800 transition cursor-pointer">
          Publish Site
        </button>
      <% end %>
      <a href="<%= business_site_url(@business) %>" target="_blank" rel="noopener" data-turbo="false" class="w-full inline-flex items-center justify-center px-3.5 py-2 rounded-lg border border-zinc-200/70 text-zinc-600 text-[13px] font-medium hover:bg-zinc-50 transition">
        Open Live Site
      </a>
    </div>
  </aside>

  <section class="min-h-0 flex flex-col">
    <div class="h-12 px-4 bg-white border-b border-zinc-200/70 flex items-center justify-between gap-3">
      <div class="min-w-0">
        <p class="text-[12px] font-medium text-zinc-700 truncate"><%= @page.title %></p>
        <p class="text-[11px] text-zinc-400 font-mono leading-tight"><%= @page.slug %></p>
      </div>
      <%= link_to "Refresh Preview", admin_website_path(page_id: @page.id), class: "text-[12px] text-zinc-500 hover:text-zinc-800" %>
    </div>
    <div class="flex-1 min-h-0 p-4">
      <% if @static_deployed %>
        <iframe
          id="tenant-builder-frame"
          src="<%= admin_static_website_preview_path(path: @static_path) %>"
          class="w-full h-full rounded-xl border border-zinc-200 bg-white shadow-sm"
          title="Website editor preview"
        ></iframe>
      <% else %>
        <div class="w-full h-full rounded-xl border border-zinc-200 bg-white shadow-sm flex items-center justify-center p-6 text-center">
          <div class="max-w-md">
            <h3 class="text-[16px] font-semibold text-zinc-800">No deployed static website found</h3>
            <p class="text-[13px] text-zinc-500 mt-2">Deploy a ZIP for this tenant first, then the editor will open the actual static files here.</p>
          </div>
        </div>
      <% end %>
    </div>
  </section>
</div>
