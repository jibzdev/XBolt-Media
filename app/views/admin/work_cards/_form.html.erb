<% if work_card.errors.any? %>
  <div class="bg-red-50 border border-red-200/70 rounded-lg px-3.5 py-2.5 mb-4">
    <h4 class="text-[13px] font-medium text-red-700 mb-1.5">Please fix the following:</h4>
    <ul class="list-disc pl-4 space-y-0.5">
      <% work_card.errors.full_messages.each do |message| %>
        <li class="text-[12px] text-red-600"><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-3">
  <div>
    <label class="block text-[13px] font-medium text-zinc-600 mb-1.5">Name</label>
    <%= f.text_field :name, class: "w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300", placeholder: "Business name" %>
  </div>
  <div>
    <label class="block text-[13px] font-medium text-zinc-600 mb-1.5">Domain URL</label>
    <%= f.text_field :domain_url, class: "w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300", placeholder: "https://example.com" %>
    <p class="text-[11px] text-zinc-400 mt-1">Use the full domain. If you enter `example.com`, it will save as `https://example.com`.</p>
  </div>
  <div>
    <label class="block text-[13px] font-medium text-zinc-600 mb-1.5">Position</label>
    <%= f.number_field :position, class: "w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300" %>
  </div>
  <div class="lg:col-span-2">
    <div class="flex items-center justify-between gap-4 mb-1.5">
      <label class="block text-[13px] font-medium text-zinc-600">Project image</label>
      <span id="work-card-image-status" class="text-[11px] text-zinc-400"></span>
    </div>

    <%= f.hidden_field :image_url, id: "work_card_image_url" %>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
      <div class="p-3.5 rounded-lg bg-zinc-50 border border-zinc-200/70">
        <input id="work_card_image_file" type="file" accept="image/*" class="block w-full text-[12px] text-zinc-600 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-[12px] file:font-medium file:bg-zinc-900 file:text-white file:cursor-pointer hover:file:bg-zinc-800">
        <p class="text-[11px] text-zinc-400 mt-1.5">Upload an image (recommended: 1200x800 or similar).</p>
      </div>

      <div class="p-3.5 rounded-lg bg-zinc-50 border border-zinc-200/70">
        <div class="text-[11px] font-medium text-zinc-400 uppercase tracking-wider mb-1.5">Preview</div>
        <img
          id="work_card_image_preview"
          src="<%= work_card.image_url.presence || '' %>"
          alt=""
          class="w-full h-36 object-cover rounded-lg border border-zinc-200/70 <%= work_card.image_url.present? ? '' : 'hidden' %>"
        />
        <div id="work_card_image_empty" class="text-[12px] <%= work_card.image_url.present? ? 'hidden' : '' %> text-zinc-400">
          No image yet.
        </div>
      </div>
    </div>
  </div>
  <div class="lg:col-span-2">
    <label class="block text-[13px] font-medium text-zinc-600 mb-1.5">Description</label>
    <%= f.text_area :description, rows: 4, class: "w-full px-3 py-2 rounded-lg border border-zinc-200/70 text-[13px] text-zinc-800 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-300 resize-none", placeholder: "Short description shown on the Work page..." %>
  </div>
</div>

<label class="mt-3 flex items-center gap-2 text-[13px] text-zinc-700">
  <%= f.check_box :active, { class: "rounded border-zinc-300 text-zinc-900 focus:ring-zinc-300 h-4 w-4", include_hidden: true }, "1", "0" %>
  Show this card on Work page
</label>

<script>
  (() => {
    const input = document.getElementById("work_card_image_file");
    if (!input) return;

    const status = document.getElementById("work-card-image-status");
    const hidden = document.getElementById("work_card_image_url");
    const preview = document.getElementById("work_card_image_preview");
    const empty = document.getElementById("work_card_image_empty");
    const csrf = document.querySelector('meta[name="csrf-token"]')?.getAttribute("content");

    const setStatus = (text) => {
      if (status) status.textContent = text || "";
    };

    input.addEventListener("change", async () => {
      const file = input.files && input.files[0];
      if (!file) return;

      setStatus("Uploading...");

      try {
        const fd = new FormData();
        fd.append("file", file);

        const res = await fetch("<%= upload_image_path %>", {
          method: "POST",
          headers: csrf ? { "X-CSRF-Token": csrf } : {},
          body: fd
        });

        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.url) throw new Error(data.error || "Upload failed");

        hidden.value = data.url;
        if (preview) {
          preview.src = data.url;
          preview.classList.remove("hidden");
        }
        if (empty) empty.classList.add("hidden");

        setStatus("Uploaded");
      } catch (e) {
        setStatus("Upload failed");
        console.error(e);
      }
    });
  })();
</script>
