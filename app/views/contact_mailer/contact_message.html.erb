<p><strong>New message from the contact form</strong></p>

<p>
  <strong>Name:</strong> <%= @name %><br>
  <strong>Email:</strong> <%= @email %><br>
  <% if @phone.present? %>
    <strong>Phone:</strong> <%= @phone %><br>
  <% end %>
</p>

<p><strong>Message:</strong></p>
<p><%= simple_format(@message) %></p>

