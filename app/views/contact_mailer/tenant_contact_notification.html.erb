<p style="margin: 0 0 16px; color: #3f3f46; font-size: 15px;">You have a new enquiry from your website.</p>

<table width="100%" cellpadding="0" cellspacing="0" style="background-color: #fafafa; border: 1px solid #e4e4e7; border-radius: 8px; margin: 16px 0;">
  <tr>
    <td style="padding: 16px 20px;">
      <p style="margin: 0 0 8px; font-size: 14px; color: #52525b;"><strong style="color: #18181b;">Name:</strong> <%= @name %></p>
      <p style="margin: 0 0 8px; font-size: 14px; color: #52525b;"><strong style="color: #18181b;">Email:</strong> <a href="mailto:<%= @email %>" style="color: #18181b;"><%= @email %></a></p>
      <% if @phone.present? %>
        <p style="margin: 0; font-size: 14px; color: #52525b;"><strong style="color: #18181b;">Phone:</strong> <a href="tel:<%= @phone %>" style="color: #18181b;"><%= @phone %></a></p>
      <% end %>
    </td>
  </tr>
</table>

<p style="margin: 16px 0 8px; font-size: 14px; color: #18181b;"><strong>Message:</strong></p>
<table width="100%" cellpadding="0" cellspacing="0" style="margin: 0 0 16px;">
  <tr>
    <td style="border-left: 3px solid #18181b; padding: 12px 16px; background-color: #fafafa; border-radius: 0 6px 6px 0; font-size: 14px; color: #3f3f46; line-height: 1.6;">
      <%= simple_format(@message) %>
    </td>
  </tr>
</table>

<p style="margin: 20px 0 0; font-size: 12px; color: #a1a1aa;">You can reply directly to this email to respond to <%= @name %>.</p>
