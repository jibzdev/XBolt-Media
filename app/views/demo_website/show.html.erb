<% primary_rgb = @theme[:primary].delete("#").scan(/../).map { |hex| hex.to_i(16) }.join(", ") %>
<% accent_rgb = @theme[:accent].delete("#").scan(/../).map { |hex| hex.to_i(16) }.join(", ") %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= @demo.site_title %></title>
    <meta name="description" content="<%= @demo.hero_subheading %>">
    <meta name="theme-color" content="<%= @theme[:primary] %>">
    <meta name="robots" content="index,follow">
    <meta property="og:title" content="<%= @demo.site_title %>">
    <meta property="og:description" content="<%= @demo.hero_subheading %>">
    <meta property="og:type" content="website">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '<%= @theme[:primary] %>',
                        secondary: '#1A202C',
                        dark: '#1A1A2E',
                        light: '#F8F8FF'
                    },
                    fontFamily: {
                        sans: ['Poppins', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <style>
        :root {
            --theme-primary: <%= @theme[:primary] %>;
            --theme-accent: <%= @theme[:accent] %>;
            --theme-bg: <%= @theme[:bg] %>;
            --theme-primary-rgb: <%= primary_rgb %>;
            --theme-accent-rgb: <%= accent_rgb %>;
        }

        /* Generic theme mapping for any leftover purple/indigo Tailwind utility class */
        [class*="text-purple-"], [class*="hover:text-purple-"]:hover {
            color: var(--theme-accent) !important;
        }

        [class*="bg-purple-"], [class*="hover:bg-purple-"]:hover {
            background-color: rgb(var(--theme-primary-rgb), 0.22) !important;
        }

        [class*="bg-indigo-"], [class*="hover:bg-indigo-"]:hover {
            background-color: rgb(var(--theme-accent-rgb), 0.25) !important;
        }

        [class*="border-purple-"], [class*="hover:border-purple-"]:hover {
            border-color: color-mix(in srgb, var(--theme-primary) 45%, #111827) !important;
        }

        [class*="shadow-purple-"], [class*="hover:shadow-purple-"]:hover {
            --tw-shadow-color: rgb(var(--theme-primary-rgb), 0.45) !important;
            --tw-shadow: 0 10px 24px -8px rgb(var(--theme-primary-rgb), 0.45) !important;
            box-shadow: var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000), var(--tw-shadow) !important;
        }

        [class*="from-purple-"] {
            --tw-gradient-from: color-mix(in srgb, var(--theme-primary) 25%, transparent) var(--tw-gradient-from-position) !important;
        }
        [class*="via-purple-"] {
            --tw-gradient-via: color-mix(in srgb, var(--theme-primary) 18%, transparent) var(--tw-gradient-via-position) !important;
        }
        [class*="to-purple-"], [class*="to-indigo-"] {
            --tw-gradient-to: color-mix(in srgb, var(--theme-accent) 22%, transparent) var(--tw-gradient-to-position) !important;
        }

        .text-purple-300, .text-purple-400, .text-purple-500,
        .hover\:text-purple-300:hover, .hover\:text-purple-400:hover {
            color: var(--theme-accent) !important;
        }

        .bg-purple-600, .hover\:bg-purple-500:hover,
        .from-purple-600, .to-purple-500 {
            background-color: var(--theme-primary) !important;
            background-image: none !important;
        }

        .bg-purple-700\/20, .bg-purple-600\/30, .bg-purple-500\/10,
        .bg-purple-500\/20, .bg-purple-500\/50, .hover\:bg-purple-500\/10:hover {
            background-color: rgb(var(--theme-primary-rgb), 0.22) !important;
        }

        .bg-indigo-600\/25, .bg-indigo-400, .bg-indigo-300 {
            background-color: rgb(var(--theme-accent-rgb), 0.25) !important;
        }

        .border-purple-500\/10, .border-purple-500\/20, .border-purple-500\/30, .border-purple-500\/50,
        .hover\:border-purple-500:hover {
            border-color: color-mix(in srgb, var(--theme-primary) 35%, #1f2937) !important;
        }

        .border-purple-500, .border-purple-400, .border-purple-600,
        .border-t.border-purple-500\/10, .border-t.border-purple-500\/20 {
            border-color: color-mix(in srgb, var(--theme-primary) 45%, #111827) !important;
        }

        .from-purple-950\/30 {
            --tw-gradient-from: color-mix(in srgb, var(--theme-primary) 30%, transparent) var(--tw-gradient-from-position) !important;
        }

        .to-indigo-950\/20 {
            --tw-gradient-to: color-mix(in srgb, var(--theme-accent) 20%, transparent) var(--tw-gradient-to-position) !important;
        }

        .from-purple-900\/20, .via-purple-950\/20, .via-purple-950\/10 {
            --tw-gradient-from: color-mix(in srgb, var(--theme-primary) 20%, transparent) var(--tw-gradient-from-position) !important;
            --tw-gradient-via: color-mix(in srgb, var(--theme-primary) 14%, transparent) var(--tw-gradient-via-position) !important;
        }

        .shadow-purple-500\/30, .hover\:shadow-purple-500\/50:hover {
            --tw-shadow-color: rgb(var(--theme-primary-rgb), 0.45) !important;
            --tw-shadow: 0 10px 24px -8px rgb(var(--theme-primary-rgb), 0.45) !important;
            box-shadow: var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000), var(--tw-shadow) !important;
        }

        .beam {
            background: linear-gradient(to right, var(--theme-primary), var(--theme-accent)) !important;
            box-shadow: 0 0 10px rgb(var(--theme-primary-rgb), 0.5) !important;
        }

        .clip-diagonal {
            clip-path: polygon(0 0, 100% 0, 100% 85%, 0 100%);
        }
        
        .text-shadow {
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
        }
        
        .bg-pattern {
            background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23<%= @theme[:primary].gsub('#', '') %>' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
        }

        #navbar { transition: all 0.3s ease-in-out; }
        .navbar-scrolled {
            background-color: rgba(0, 0, 0, 0.45);
            backdrop-filter: blur(10px);
            margin-top: 0 !important;
        }

        @keyframes scrollBounce {
            0%, 100% { transform: translateY(0); opacity: 1; }
            50% { transform: translateY(8px); opacity: 0.5; }
        }
        @keyframes fade-in-up {
            0% { opacity: 0; transform: translateY(30px); }
            100% { opacity: 1; transform: translateY(0); }
        }
        @keyframes float-1 {
            0%, 100% { transform: translate(0, 0) scale(1); }
            33% { transform: translate(50px, -50px) scale(1.1); }
            66% { transform: translate(-30px, 30px) scale(0.95); }
        }
        @keyframes float-2 {
            0%, 100% { transform: translate(0, 0) scale(1); }
            33% { transform: translate(-60px, 40px) scale(1.08); }
            66% { transform: translate(40px, -40px) scale(0.92); }
        }
        @keyframes float-3 {
            0%, 100% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(30px, 30px) scale(1.05); }
        }
        @keyframes grid-flow {
            0% { transform: translate(0, 0); }
            100% { transform: translate(50px, 50px); }
        }
        @keyframes float-particle-1 {
            0%, 100% { transform: translateY(0); opacity: 0.8; }
            50% { transform: translateY(-100px); opacity: 1; }
        }
        @keyframes float-particle-2 {
            0%, 100% { transform: translateY(0); opacity: 0.6; }
            50% { transform: translateY(-80px); opacity: 1; }
        }
        @keyframes float-particle-3 {
            0%, 100% { transform: translateY(0); opacity: 0.9; }
            50% { transform: translateY(-120px); opacity: 1; }
        }
        @keyframes float-particle-4 {
            0%, 100% { transform: translateY(0); opacity: 0.7; }
            50% { transform: translateY(-90px); opacity: 1; }
        }
        @keyframes spin-very-slow { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
        @keyframes spin-reverse-slow { from { transform: rotate(0deg); } to { transform: rotate(-360deg); } }
        @keyframes pulse-ring {
            0%, 100% { transform: scale(1); opacity: 0.1; }
            50% { transform: scale(1.2); opacity: 0.15; }
        }
        @keyframes shimmer-1 {
            0%, 100% { opacity: 0.2; transform: translateY(0); }
            50% { opacity: 0.6; transform: translateY(-20px); }
        }
        @keyframes shimmer-2 {
            0%, 100% { opacity: 0.15; transform: translateY(0); }
            50% { opacity: 0.5; transform: translateY(-30px); }
        }
        @keyframes shimmer-3 {
            0%, 100% { opacity: 0.18; transform: translateY(0); }
            50% { opacity: 0.55; transform: translateY(-25px); }
        }
        @keyframes scroll-text {
            0% { transform: translateY(0); }
            100% { transform: translateY(-20%); }
        }
        @keyframes float-slow {
            0%, 100% { transform: translateY(0px) translateX(0px); }
            50% { transform: translateY(-30px) translateX(20px); }
        }
        @keyframes float-slower {
            0%, 100% { transform: translateY(0px) translateX(0px); }
            50% { transform: translateY(-20px) translateX(-15px); }
        }
        @keyframes pulse-slow {
            0%, 100% { opacity: 0.15; transform: scale(1); }
            50% { opacity: 0.25; transform: scale(1.1); }
        }
        @keyframes pulse-slower {
            0%, 100% { opacity: 0.12; transform: scale(1); }
            50% { opacity: 0.22; transform: scale(1.15); }
        }
        @keyframes pulse-glow {
            0%, 100% { opacity: 0.12; transform: scale(1); }
            50% { opacity: 0.20; transform: scale(1.15); }
        }
        @keyframes pulse-glow-delay {
            0%, 100% { opacity: 0.10; transform: scale(1); }
            50% { opacity: 0.18; transform: scale(1.2); }
        }

        .animate-fade-in-up { animation: fade-in-up 0.8s ease-out forwards; opacity: 0; }
        .animate-float-slow { animation: float-slow 12s ease-in-out infinite; }
        .animate-float-slower { animation: float-slower 15s ease-in-out infinite; }
        .animate-pulse-slow { animation: pulse-slow 8s ease-in-out infinite; }
        .animate-pulse-slower { animation: pulse-slower 10s ease-in-out infinite 2s; }
        .animate-pulse-glow { animation: pulse-glow 9s ease-in-out infinite; }
        .animate-pulse-glow-delay { animation: pulse-glow-delay 11s ease-in-out infinite 3s; }
        .animate-scrollBounce { animation: scrollBounce 2s ease-in-out infinite; }
        .animate-float-1 { animation: float-1 20s ease-in-out infinite; }
        .animate-float-2 { animation: float-2 25s ease-in-out infinite; }
        .animate-float-3 { animation: float-3 22s ease-in-out infinite; }
        .animate-float-particle-1 { animation: float-particle-1 8s ease-in-out infinite; }
        .animate-float-particle-2 { animation: float-particle-2 10s ease-in-out infinite 2s; }
        .animate-float-particle-3 { animation: float-particle-3 12s ease-in-out infinite 4s; }
        .animate-float-particle-4 { animation: float-particle-4 9s ease-in-out infinite 1s; }
        .animate-spin-very-slow { animation: spin-very-slow 30s linear infinite; }
        .animate-spin-reverse-slow { animation: spin-reverse-slow 35s linear infinite; }
        .animate-pulse-ring { animation: pulse-ring 4s ease-in-out infinite; }
        .animate-shimmer-1 { animation: shimmer-1 8s ease-in-out infinite; }
        .animate-shimmer-2 { animation: shimmer-2 10s ease-in-out infinite 2s; }
        .animate-shimmer-3 { animation: shimmer-3 9s ease-in-out infinite 1s; }
    </style>
</head>
<body class="font-sans antialiased text-dark bg-light overflow-x-hidden">
    <!-- Navigation -->
    <nav class="fixed w-full z-50 transition-all duration-300" id="navbar">
        <div class="container mx-auto px-6 py-6">
            <div class="backdrop-blur-xl rounded-2xl border shadow-2xl" style="background: rgba(0,0,0,0.3); border-color: rgba(255,255,255,0.1);">
                <div class="px-6 py-4">
                    <div class="grid grid-cols-3 items-center" data-aos="fade-down" data-aos-duration="1000">
                        <!-- Logo - Left -->
                        <div class="flex items-center justify-start">
                            <a href="/" class="text-white hover:opacity-80 transition-opacity">
                                <div class="text-xl font-bold tracking-tight"><%= @demo.site_title %></div>
                            </a>
                        </div>
                        
                        <!-- Navigation Links - Center -->
                        <div class="hidden md:flex items-center justify-center">
                            <div class="flex items-center space-x-8">
                                <a href="#top" class="nav-link text-white/80 hover:text-white transition-all duration-300 text-sm font-medium">Home</a>
                                <a href="#services" class="nav-link text-white/80 hover:text-white transition-all duration-300 text-sm font-medium">Services</a>
                                <a href="#projects" class="nav-link text-white/80 hover:text-white transition-all duration-300 text-sm font-medium">Gallery</a>
                                <a href="#contact" class="nav-link text-white/80 hover:text-white transition-all duration-300 text-sm font-medium">Contact</a>
                            </div>
                        </div>
                        
                        <!-- CTA Button - Right -->
                        <div class="hidden md:flex items-center justify-end">
                            <a href="#contact" class="px-5 py-2.5 text-white rounded-xl text-sm font-bold hover:opacity-90 transition-all duration-300 transform hover:scale-105 inline-flex items-center shadow-lg" style="background: <%= @theme[:primary] %>;">
                                <span><%= @demo.cta_primary_text %></span>
                                <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                                </svg>
                            </a>
                        </div>
                        
                        <!-- Mobile Menu Button -->
                        <div class="md:hidden col-span-2 flex justify-end">
                            <button id="mobile-menu-button" class="text-white hover:text-gray-300 p-2">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <div id="top" class="relative min-h-screen overflow-hidden" style="background: <%= @theme[:bg] %>;">
        <!-- Gradient orbs -->
        <div class="absolute inset-0">
            <div class="absolute top-0 left-0 w-[700px] h-[700px] rounded-full blur-[140px] opacity-40 animate-float-1" style="background: <%= @theme[:primary] %>;"></div>
            <div class="absolute bottom-0 right-0 w-[600px] h-[600px] rounded-full blur-[120px] opacity-35 animate-float-2" style="background: <%= @theme[:accent] %>;"></div>
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] rounded-full blur-[100px] opacity-20 animate-pulse-slow" style="background: <%= @theme[:primary] %>;"></div>
        </div>
        
        <!-- Floating particles -->
        <div class="absolute inset-0">
            <div class="absolute top-[15%] left-[10%] w-2 h-2 rounded-full animate-float-particle-1" style="background: <%= @theme[:primary] %>;"></div>
            <div class="absolute top-[35%] right-[15%] w-1.5 h-1.5 rounded-full animate-float-particle-2" style="background: <%= @theme[:accent] %>;"></div>
            <div class="absolute bottom-[25%] left-[20%] w-2.5 h-2.5 rounded-full animate-float-particle-3" style="background: <%= @theme[:primary] %>;"></div>
            <div class="absolute top-[60%] right-[25%] w-2 h-2 rounded-full animate-float-particle-4" style="background: <%= @theme[:accent] %>;"></div>
            <div class="absolute top-[45%] left-[35%] w-1.5 h-1.5 rounded-full animate-float-particle-1" style="background: <%= @theme[:primary] %>; animation-delay: 3s;"></div>
            <div class="absolute bottom-[40%] right-[40%] w-2 h-2 rounded-full animate-float-particle-2" style="background: <%= @theme[:accent] %>; animation-delay: 1.5s;"></div>
        </div>

        <!-- Main Content -->
        <div class="relative z-10 min-h-screen flex items-center justify-center px-4 pt-24">
            <div class="max-w-5xl mx-auto">
                <div class="text-center">
                    
                    <!-- Badge -->
                    <div class="flex justify-center mb-8 opacity-0 animate-fade-in-up" style="animation-delay: 0.2s">
                        <div class="inline-flex items-center gap-2 px-5 py-2 rounded-full backdrop-blur-md border shadow-lg" style="background: rgba(255,255,255,0.08); border-color: <%= @theme[:accent] %>40;">
                            <div class="w-2 h-2 rounded-full animate-pulse" style="background: <%= @theme[:accent] %>;"></div>
                            <span class="text-white text-sm font-semibold"><%= @demo.hero_badge %></span>
                        </div>
                    </div>

                    <!-- Main Title -->
                    <h1 class="text-5xl md:text-7xl lg:text-8xl font-black mb-6 opacity-0 animate-fade-in-up leading-tight" style="animation-delay: 0.3s">
                        <span class="block text-white mb-3"><%= @demo.site_title %></span>
                        <span class="block text-transparent bg-clip-text bg-gradient-to-r" style="background-image: linear-gradient(to right, <%= @theme[:primary] %>, <%= @theme[:accent] %>);"><%= @demo.hero_heading %></span>
                    </h1>

                    <!-- Subheading -->
                    <p class="text-gray-300 max-w-2xl mx-auto text-lg md:text-xl mb-12 opacity-0 animate-fade-in-up leading-relaxed" style="animation-delay: 0.4s">
                        <%= @demo.hero_subheading %>
                    </p>

                    <!-- CTA Buttons -->
                    <div class="flex flex-col sm:flex-row gap-4 justify-center opacity-0 animate-fade-in-up" style="animation-delay: 0.5s">
                        <a href="#contact" class="group px-8 py-4 text-white font-bold rounded-xl transition-all hover:scale-105 hover:shadow-2xl inline-flex items-center justify-center gap-2 shadow-lg" style="background: <%= @theme[:primary] %>; box-shadow: 0 10px 40px -10px <%= @theme[:primary] %>80;">
                            <%= @demo.cta_primary_text %>
                            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                            </svg>
                        </a>
                        <a href="#projects" class="px-8 py-4 border-2 text-white font-bold rounded-xl transition-all hover:scale-105 inline-flex items-center justify-center gap-2 backdrop-blur-sm" style="border-color: <%= @theme[:accent] %>; background: rgba(255,255,255,0.05);">
                            <%= @demo.cta_secondary_text %>
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                            </svg>
                        </a>
                    </div>

                </div>
            </div>
        </div>

        <!-- Minimal Scroll Indicator -->
        <div class="absolute bottom-10 left-1/2 -translate-x-1/2 opacity-50">
            <div class="w-6 h-10 border-2 rounded-full flex justify-center" style="border-color: <%= @theme[:accent] %>60;">
                <div class="w-1 h-2 rounded-full mt-2 animate-scrollBounce" style="background: <%= @theme[:accent] %>;"></div>
            </div>
        </div>
    </div>

    <!-- Services/About Section -->
    <section id="services" class="py-32 relative overflow-hidden" style="background: <%= @theme[:bg] %>;">
        <!-- Dot grid pattern -->
        <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(circle, <%= @theme[:primary] %> 1px, transparent 1px); background-size: 40px 40px;"></div>
        <!-- Radial gradient mesh -->
        <div class="absolute inset-0">
            <div class="absolute top-0 right-0 w-[500px] h-[500px] rounded-full blur-[120px] opacity-20 animate-pulse-slow" style="background: <%= @theme[:accent] %>;"></div>
            <div class="absolute bottom-0 left-0 w-[450px] h-[450px] rounded-full blur-[100px] opacity-15 animate-pulse-slower" style="background: <%= @theme[:primary] %>;"></div>
        </div>
        
        <div class="container mx-auto px-6 relative z-10 max-w-6xl">
            <div class="text-center mb-20" data-aos="fade-up">
                <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full backdrop-blur-md border mb-6" style="background: rgba(255,255,255,0.05); border-color: <%= @theme[:accent] %>40;">
                    <span class="font-semibold text-sm" style="color: <%= @theme[:accent] %>;"><%= @demo.services_title %></span>
                </div>
                <h2 class="text-4xl md:text-6xl font-black text-white mb-6 leading-tight">
                    <%= @demo.services_title %>
                </h2>
                <p class="text-white/70 max-w-3xl mx-auto text-lg leading-relaxed mb-12">
                    <%= @demo.services_intro %>
                </p>

                <!-- Stats -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-8 max-w-4xl mx-auto mb-16" data-aos="fade-up" data-aos-delay="100">
                    <% @demo.stat_items.each do |stat| %>
                      <div class="text-center">
                        <div class="text-4xl md:text-5xl font-black mb-2 text-transparent bg-clip-text bg-gradient-to-br" style="background-image: linear-gradient(to bottom right, <%= @theme[:primary] %>, <%= @theme[:accent] %>);"><%= stat[:number] %></div>
                        <div class="text-sm text-white/60 font-medium"><%= stat[:label] %></div>
                      </div>
                    <% end %>
                </div>
            </div>

            <!-- Features Grid -->
            <div class="grid md:grid-cols-3 gap-8 mt-16">
                <% icons = [
                  "M13 10V3L4 14h7v7l9-11h-7z",
