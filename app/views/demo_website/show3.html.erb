<script>
(() => {
  // ── Navbar scroll ─────────────────────────────────────────────────────────────
  const nav = document.getElementById('nav3');
  const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 50);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // ── Hamburger / mobile menu ───────────────────────────────────────────────────
  const ham  = document.getElementById('ham3');
  const mob  = document.getElementById('mob3');
  const bars = document.getElementById('ham3-bars');
  const xIcon = document.getElementById('ham3-x');

  ham?.addEventListener('click', () => {
    const open = mob.classList.toggle('open');
    bars.classList.toggle('hidden', open);
    xIcon.classList.toggle('hidden', !open);
  });
  mob?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
    mob.classList.remove('open');
    bars.classList.remove('hidden');
    xIcon.classList.add('hidden');
  }));

  // ── Active nav highlight ──────────────────────────────────────────────────────
  const sections = document.querySelectorAll('section[id]');
  const links    = document.querySelectorAll('.nl');
  const navH     = nav.offsetHeight;

  const setActive = () => {
    let cur = '';
    sections.forEach(s => { if (window.scrollY >= s.offsetTop - navH - 60) cur = s.id; });
    links.forEach(l => l.classList.toggle('active', l.getAttribute('href') === `#${cur}`));
  };
  window.addEventListener('scroll', setActive, { passive: true });
  setActive();

  // ── Scroll reveal ─────────────────────────────────────────────────────────────
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('vis'); io.unobserve(e.target); } });
  }, { threshold: 0.10 });
  document.querySelectorAll('.sr').forEach(el => io.observe(el));

  // ── Smooth scroll ─────────────────────────────────────────────────────────────
  document.querySelectorAll('a[href^="#"]').forEach(a => {
    a.addEventListener('click', e => {
      const t = document.querySelector(a.getAttribute('href'));
      if (!t) return;
      e.preventDefault();
      window.scrollTo({ top: t.getBoundingClientRect().top + scrollY - navH, behavior: 'smooth' });
    });
  });
})();
</script>
</body>
</html>
