<% contact_email = @general_setting&.contact_email || 'info@xboltmedia.com' %>
<% phone_number = @general_setting&.phone_number || '+447459731426' %>

<footer class="relative pt-2 pb-14">
  <!-- Soft amber accent line that fades into the page (replaces hard separator) -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[60%] max-w-3xl h-px bg-gradient-to-r from-transparent via-amber-500/30 to-transparent pointer-events-none"></div>
  <!-- Subtle radial accent above the columns -->
  <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-[600px] h-48 rounded-full bg-amber-500/[0.05] blur-[100px] pointer-events-none"></div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 pt-14 relative">
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-8 lg:gap-12">
      <div class="col-span-2 sm:col-span-1">
        <div class="flex items-center gap-2.5 mb-4">
          <img src="<%= brand_logo_url %>" alt="Logo" class="h-7 w-auto object-contain brightness-0 invert">
          <span class="text-sm font-bold text-white tracking-tight">XBolt<span class="text-amber-500">.</span></span>
        </div>
        <p class="text-xs text-zinc-600 leading-relaxed max-w-[200px]">Premium websites and systems for modern businesses.</p>
        <%= render 'landing/social_links', wrapper_class: 'mt-4' %>
      </div>

      <div>
        <h4 class="text-[11px] font-semibold uppercase tracking-[0.14em] text-amber-500/50 mb-4">Services</h4>
        <ul class="space-y-2.5">
          <li><a href="<%= services_path %>" class="text-xs text-zinc-500 hover:text-amber-400 transition">Design</a></li>
          <li><a href="<%= services_path %>" class="text-xs text-zinc-500 hover:text-amber-400 transition">Engineering</a></li>
          <li><a href="<%= services_path %>" class="text-xs text-zinc-500 hover:text-amber-400 transition">Analytics</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-[11px] font-semibold uppercase tracking-[0.14em] text-amber-500/50 mb-4">Company</h4>
        <ul class="space-y-2.5">
          <li><a href="<%= about_path %>" class="text-xs text-zinc-500 hover:text-amber-400 transition">About</a></li>
          <li><a href="<%= work_path %>" class="text-xs text-zinc-500 hover:text-amber-400 transition">Work</a></li>
          <li><a href="<%= reviews_path %>" class="text-xs text-zinc-500 hover:text-amber-400 transition">Reviews</a></li>
          <li><a href="<%= contact_path %>" class="text-xs text-zinc-500 hover:text-amber-400 transition">Contact</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-[11px] font-semibold uppercase tracking-[0.14em] text-amber-500/50 mb-4">Get in touch</h4>
        <ul class="space-y-2.5">
          <li><a href="mailto:<%= contact_email %>" class="text-xs text-zinc-500 hover:text-amber-400 transition break-all"><%= contact_email %></a></li>
          <li><a href="tel:<%= phone_number %>" class="text-xs text-zinc-500 hover:text-amber-400 transition"><%= phone_number %></a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-white/[0.04] flex flex-col sm:flex-row justify-between items-center gap-3">
      <p class="text-[11px] text-zinc-600">&copy; <%= Time.current.year %> <%= @general_setting&.application_name.presence || "XBolt Media" %>. All rights reserved.</p>
      <div class="flex items-center gap-5">
        <%= link_to "Privacy", privacy_policy_path, class: "text-[11px] text-zinc-600 hover:text-amber-400 transition" %>
        <%= link_to "Terms", terms_of_service_path, class: "text-[11px] text-zinc-600 hover:text-amber-400 transition" %>
      </div>
    </div>
  </div>
</footer>
