<!DOCTYPE html>
<html lang="en">
<head>
    <%= seo_meta_tags('faq') rescue nil %>
    <title>FAQ · XBolt Media</title>
    <meta name="description" content="Frequently asked questions about XBolt Media websites, timelines, support, and how to get started.">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet">
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <%= render "layouts/theme" %>
    <link rel="icon" type="image/png" href="<%= brand_favicon_url %>">
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        body { font-family: 'Inter', system-ui, sans-serif; background: #09090b; }
        [data-anim] { opacity: 0; transform: translateY(36px); transition: opacity 0.85s cubic-bezier(0.16,1,0.3,1), transform 0.85s cubic-bezier(0.16,1,0.3,1); }
        [data-anim].is-visible { opacity: 1; transform: translateY(0); }
        .xb-grad-amber { background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 50%, #d97706 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
        .xb-grad-white { background: linear-gradient(180deg, #fff 0%, rgba(255,255,255,0.6) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
        .xb-faq-item { border: 1px solid rgba(255,255,255,0.06); background: rgba(255,255,255,0.03); border-radius: 1rem; overflow: hidden; }
        .xb-faq-item[open] { border-color: rgba(251,191,36,0.18); background: rgba(251,191,36,0.04); }
        .xb-faq-item summary { list-style: none; cursor: pointer; }
        .xb-faq-item summary::-webkit-details-marker { display: none; }
        .xb-faq-chevron { transition: transform 0.25s ease; }
        .xb-faq-item[open] .xb-faq-chevron { transform: rotate(180deg); }
        @media (prefers-reduced-motion: reduce) { [data-anim] { opacity: 1 !important; transform: none !important; transition: none !important; } }
    </style>
</head>
<body class="text-white antialiased overflow-x-hidden">
    <%= render 'landing/navbar' %>

    <main>
        <section class="pt-36 sm:pt-44 pb-24" style="background: #09090b;">
            <div class="container mx-auto px-4 sm:px-6 lg:px-8">
                <div class="max-w-3xl mx-auto text-center mb-14" data-anim>
                    <div class="inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.2em] font-semibold text-amber-500/70 mb-4">
                        <span class="w-5 h-px bg-amber-500/40"></span> FAQ <span class="w-5 h-px bg-amber-500/40"></span>
                    </div>
                    <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-[-0.04em] xb-grad-white">Frequently asked questions</h1>
                    <p class="mt-5 text-base sm:text-lg text-zinc-500 leading-relaxed max-w-xl mx-auto">
                        Straight answers about timelines, support, and working with XBolt Media.
                    </p>
                </div>

                <div class="max-w-3xl mx-auto space-y-3" data-anim>
                    <% @faqs.each do |faq| %>
                        <details class="xb-faq-item">
                            <summary class="flex items-center justify-between gap-4 px-5 py-4">
                                <span class="text-sm sm:text-base font-semibold text-white text-left"><%= faq[:question] %></span>
                                <i class='bx bx-chevron-down text-amber-400 text-xl xb-faq-chevron flex-shrink-0'></i>
                            </summary>
                            <div class="px-5 pb-5">
                                <p class="text-sm text-zinc-500 leading-relaxed"><%= faq[:answer] %></p>
                            </div>
                        </details>
                    <% end %>
                </div>

                <div class="max-w-2xl mx-auto text-center mt-16" data-anim>
                    <p class="text-sm text-zinc-500 mb-5">Still have a question?</p>
                    <a href="<%= contact_path %>" class="group inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-amber-500 text-zinc-950 text-sm font-bold hover:bg-amber-400 transition-all shadow-[0_0_24px_rgba(251,191,36,0.3)]">
                        Contact us <i class='bx bx-right-arrow-alt text-base transition-transform group-hover:translate-x-1'></i>
                    </a>
                </div>
            </div>
        </section>
    </main>

    <%= render 'landing/footer' %>
    <%= javascript_include_tag "landing" %>
    <%= render 'layouts/toast' %>
</body>
</html>
