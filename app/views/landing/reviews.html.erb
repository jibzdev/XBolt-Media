<!DOCTYPE html>
<html lang="en">
<head>
    <%= seo_meta_tags('reviews') %>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet">
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <%= render "layouts/theme" %>
    <link rel="icon" type="image/png" href="<%= brand_favicon_url %>">
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        body { font-family: 'Inter', system-ui, sans-serif; background: #09090b; }
        [data-anim] { opacity: 0; transform: translateY(36px); transition: opacity 0.85s cubic-bezier(0.16,1,0.3,1), transform 0.85s cubic-bezier(0.16,1,0.3,1); }
        [data-anim].is-visible { opacity: 1; transform: translateY(0); }
        [data-stagger] > * { opacity: 0; transform: translateY(28px); transition: opacity 0.7s cubic-bezier(0.16,1,0.3,1), transform 0.7s cubic-bezier(0.16,1,0.3,1); }
        [data-stagger].is-visible > *:nth-child(1) { transition-delay: 0s; } [data-stagger].is-visible > *:nth-child(2) { transition-delay: 0.08s; } [data-stagger].is-visible > *:nth-child(3) { transition-delay: 0.16s; }
        [data-stagger].is-visible > *:nth-child(4) { transition-delay: 0.24s; } [data-stagger].is-visible > *:nth-child(5) { transition-delay: 0.32s; } [data-stagger].is-visible > *:nth-child(6) { transition-delay: 0.4s; }
        [data-stagger].is-visible > * { opacity: 1; transform: translateY(0); }
        .xb-grad-amber { background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 50%, #d97706 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
        .xb-grad-white { background: linear-gradient(180deg, #fff 0%, rgba(255,255,255,0.6) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
        .xb-glass {
            background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06);
            backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
            transition: border-color 0.4s ease, background 0.4s ease, transform 0.5s cubic-bezier(0.16,1,0.3,1), box-shadow 0.5s ease;
        }
        .xb-glass:hover {
            background: rgba(251,191,36,0.04); border-color: rgba(251,191,36,0.15);
            transform: translateY(-4px);
            box-shadow: 0 24px 48px -16px rgba(0,0,0,0.5), 0 0 0 1px rgba(251,191,36,0.06);
        }
        .xb-sep { height: 1px; background: linear-gradient(90deg, transparent, rgba(251,191,36,0.12) 50%, transparent); }
        @media (prefers-reduced-motion: reduce) { [data-anim], [data-stagger] > * { opacity: 1 !important; transform: none !important; transition: none !important; } .xb-glass:hover { transform: none !important; } }
    </style>
</head>
<body class="text-white antialiased overflow-x-hidden">
    <%= render 'landing/navbar' %>

    <main>
        <section class="pt-36 sm:pt-44 pb-20" style="background: #09090b;">
            <div class="container mx-auto px-4 sm:px-6 lg:px-8">

                <div class="max-w-3xl mx-auto text-center mb-16" data-anim>
                    <div class="inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.2em] font-semibold text-amber-500/70 mb-4">
                        <span class="w-5 h-px bg-amber-500/40"></span> Reviews <span class="w-5 h-px bg-amber-500/40"></span>
                    </div>
                    <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-[-0.04em] xb-grad-white">What our clients say</h1>
                    <p class="mt-5 text-base sm:text-lg text-zinc-500 leading-relaxed max-w-xl mx-auto">
                        Real feedback from the founders and business owners we've built for.
                    </p>

                    <% if @reviews.any? %>
                        <div class="mt-10 inline-flex flex-col sm:flex-row items-center gap-5 sm:gap-8 rounded-2xl border border-amber-500/[0.12] bg-white/[0.02] px-7 py-5">
                            <div class="flex flex-col items-center">
                                <div class="flex items-baseline gap-1">
                                    <span class="text-3xl font-extrabold xb-grad-amber"><%= @average_rating %></span>
                                    <span class="text-sm text-zinc-600">/ 5</span>
                                </div>
                                <div class="flex items-center gap-0.5 mt-1.5">
                                    <% full_stars = @average_rating.to_f.round %>
                                    <% full_stars.times do %><i class='bx bxs-star text-amber-400 text-sm'></i><% end %>
                                    <% (5 - full_stars).times do %><i class='bx bxs-star text-zinc-700 text-sm'></i><% end %>
                                </div>
                            </div>
                            <div class="hidden sm:block w-px h-12 bg-white/[0.06]"></div>
                            <div class="text-center sm:text-left">
                                <div class="text-sm font-semibold text-white"><%= pluralize(@reviews.size, 'review') %></div>
                                <div class="text-xs text-zinc-600 mt-0.5">From verified clients</div>
                            </div>
                            <% if google_reviews_url.present? %>
                                <div class="hidden sm:block w-px h-12 bg-white/[0.06]"></div>
                                <a href="<%= google_reviews_url %>" target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-amber-500/20 text-amber-400 text-[13px] font-semibold hover:bg-amber-500/[0.08] transition-all">
                                    <i class='bx bxl-google text-base'></i>
                                    Read on Google
                                    <i class='bx bx-right-arrow-alt text-base transition-transform group-hover:translate-x-0.5'></i>
                                </a>
                            <% end %>
                        </div>
                    <% end %>
                </div>

                <% if @reviews.any? %>
                    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" data-stagger>
                        <% @reviews.each do |review| %>
                            <div class="xb-glass rounded-2xl p-6 flex flex-col">
                                <div class="flex items-start justify-between gap-3 mb-3">
                                    <div class="flex items-center gap-0.5">
                                        <% review.rating.times do %><i class='bx bxs-star text-amber-400 text-sm'></i><% end %>
                                        <% (5 - review.rating).times do %><i class='bx bxs-star text-zinc-700 text-sm'></i><% end %>
                                    </div>
                                    <% if review.google? %>
                                        <span class="inline-flex items-center gap-1 text-[10px] font-semibold uppercase tracking-[0.12em] text-zinc-600 flex-shrink-0" title="Review posted on Google">
                                            <i class='bx bxl-google text-sm text-zinc-500'></i> Google
                                        </span>
                                    <% end %>
                                </div>

                                <p class="text-sm text-zinc-400 leading-relaxed mb-6 flex-1">"<%= review.review_text %>"</p>

                                <div class="flex items-center gap-3 pt-4 border-t border-white/[0.04]">
                                    <% avatar = review.display_avatar_url %>
                                    <% if avatar.present? %>
                                        <img src="<%= avatar %>" alt="<%= review.reviewer_name %>" loading="lazy" class="w-10 h-10 rounded-full object-cover ring-2 ring-amber-500/20 flex-shrink-0">
                                    <% else %>
                                        <div class="w-10 h-10 rounded-full bg-gradient-to-br from-amber-500/20 to-amber-600/10 flex items-center justify-center ring-2 ring-amber-500/20 flex-shrink-0">
                                            <span class="text-xs font-bold text-amber-400"><%= review.initials %></span>
                                        </div>
                                    <% end %>
                                    <div class="min-w-0">
                                        <div class="text-sm font-bold text-white truncate"><%= review.reviewer_name %></div>
                                        <% if review.display_company.present? %>
                                            <div class="text-xs text-zinc-500 truncate"><%= review.display_company %></div>
                                        <% end %>
                                    </div>
                                </div>
                            </div>
                        <% end %>
                    </div>
                <% else %>
                    <div class="max-w-md mx-auto text-center" data-anim>
                        <div class="xb-glass rounded-2xl p-10">
                            <div class="w-12 h-12 rounded-xl bg-amber-500/10 border border-amber-500/10 flex items-center justify-center mx-auto mb-5">
                                <i class='bx bx-star text-xl text-amber-400'></i>
                            </div>
                            <h2 class="text-lg font-bold text-white mb-2">Reviews coming soon</h2>
                            <p class="text-sm text-zinc-500 leading-relaxed">We're gathering feedback from our clients. Check back shortly.</p>
                        </div>
                    </div>
                <% end %>

                <div class="xb-sep mt-24 mb-0"></div>

                <div class="max-w-2xl mx-auto text-center mt-20" data-anim>
                    <h2 class="text-2xl sm:text-3xl font-bold tracking-[-0.02em]">
                        <span class="xb-grad-white">Want results like</span> <span class="xb-grad-amber">these?</span>
                    </h2>
                    <p class="mt-4 text-sm text-zinc-500 max-w-md mx-auto">Tell us what you need and we'll show you what's possible.</p>
                    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
                        <a href="<%= contact_path %>" class="group inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-amber-500 text-zinc-950 text-sm font-bold hover:bg-amber-400 transition-all shadow-[0_0_24px_rgba(251,191,36,0.3)]">
                            Start a conversation <i class='bx bx-right-arrow-alt text-base transition-transform group-hover:translate-x-1'></i>
                        </a>
                        <% if google_reviews_url.present? %>
                            <a href="<%= google_reviews_url %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl border border-amber-500/15 text-zinc-400 text-sm font-semibold hover:text-amber-400 hover:border-amber-500/30 hover:bg-amber-500/[0.04] transition-all">
                                <i class='bx bxl-google text-base'></i> Leave us a review
                            </a>
                        <% end %>
                    </div>
                </div>

            </div>
        </section>
    </main>

    <%= render 'landing/footer' %>
    <%= javascript_include_tag "landing" %>
    <%= render 'layouts/toast' %>
</body>
</html>
