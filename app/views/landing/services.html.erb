<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet">
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <%= render "layouts/theme" %>
    <link rel="icon" type="image/png" href="<%= brand_favicon_url %>">
    <title>Services — XBolt Media</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        body { font-family: 'Inter', system-ui, sans-serif; background: #09090b; }
        [data-anim] { opacity: 0; transform: translateY(36px); transition: opacity 0.85s cubic-bezier(0.16,1,0.3,1), transform 0.85s cubic-bezier(0.16,1,0.3,1); }
        [data-anim].is-visible { opacity: 1; transform: translateY(0); }
        .xb-grad-amber { background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 50%, #d97706 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
        .xb-grad-white { background: linear-gradient(180deg, #fff 0%, rgba(255,255,255,0.6) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
        .xb-glass {
            background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06);
            backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
            transition: border-color 0.4s ease, background 0.4s ease, transform 0.5s cubic-bezier(0.16,1,0.3,1), box-shadow 0.5s ease;
        }
        .xb-glass:hover {
            background: rgba(251,191,36,0.04); border-color: rgba(251,191,36,0.15);
            transform: translateY(-4px);
            box-shadow: 0 24px 48px -16px rgba(0,0,0,0.5), 0 0 0 1px rgba(251,191,36,0.06);
        }
        .xb-sep { height: 1px; background: linear-gradient(90deg, transparent, rgba(251,191,36,0.12) 50%, transparent); }
        @media (prefers-reduced-motion: reduce) { [data-anim] { opacity: 1 !important; transform: none !important; transition: none !important; } .xb-glass:hover { transform: none !important; } }
    </style>
</head>
<body class="text-white antialiased overflow-x-hidden">
    <%= render 'landing/navbar' %>

    <main>
        <section class="pt-36 sm:pt-44 pb-24" style="background: #09090b;">
            <div class="container mx-auto px-4 sm:px-6 lg:px-8">

                <div class="max-w-3xl mx-auto text-center mb-16" data-anim>
                    <div class="inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.2em] font-semibold text-amber-500/70 mb-4">
                        <span class="w-5 h-px bg-amber-500/40"></span> Pricing <span class="w-5 h-px bg-amber-500/40"></span>
                    </div>
                    <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-[-0.04em] xb-grad-white">Services & Pricing</h1>
                    <p class="mt-5 text-base sm:text-lg text-zinc-500 max-w-xl mx-auto">Transparent pricing, no surprises. Every service includes design, engineering, and launch support.</p>
                </div>

                <% if @services.any? %>
                    <% grouped = @services.group_by(&:category) %>
                    <div class="max-w-5xl mx-auto space-y-16">
                        <% grouped.each_with_index do |(category, services), ci| %>
                            <div data-anim style="transition-delay: <%= (ci * 0.08).round(2) %>s;">
                                <div class="flex items-center gap-3 mb-6">
                                    <div class="w-8 h-8 rounded-lg bg-amber-500/10 border border-amber-500/10 flex items-center justify-center text-xs font-bold text-amber-400"><%= ci + 1 %></div>
                                    <h2 class="text-xl font-bold text-white"><%= category %></h2>
                                </div>
                                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                                    <% services.each do |service| %>
                                        <div class="xb-glass rounded-2xl p-6">
                                            <h3 class="text-base font-semibold text-white mb-2"><%= service.name %></h3>
                                            <% if service.description.present? %>
                                                <p class="text-sm text-zinc-500 leading-relaxed mb-4"><%= service.description %></p>
                                            <% end %>
                                            <div class="flex items-baseline gap-1">
                                                <span class="text-2xl font-bold text-amber-400"><%= number_to_currency(service.base_price, unit: '£', precision: 0) %></span>
                                                <span class="text-xs text-zinc-600">starting</span>
                                            </div>
                                        </div>
                                    <% end %>
                                </div>
                            </div>
                        <% end %>
                    </div>
                <% else %>
                    <div class="max-w-md mx-auto text-center py-16" data-anim>
                        <div class="w-12 h-12 rounded-2xl bg-amber-500/10 border border-amber-500/10 flex items-center justify-center mx-auto mb-4">
                            <i class='bx bx-package text-xl text-amber-400'></i>
                        </div>
                        <h2 class="text-lg font-semibold text-white mb-2">Services coming soon</h2>
                        <p class="text-sm text-zinc-500">We're finalising our offerings. Get in touch for a custom quote.</p>
                    </div>
                <% end %>

                <div class="xb-sep mt-24 mb-0"></div>

                <div class="max-w-2xl mx-auto text-center mt-20" data-anim>
                    <h2 class="text-2xl sm:text-3xl font-bold tracking-[-0.02em]">
                        <span class="xb-grad-white">Need something</span> <span class="xb-grad-amber">custom?</span>
                    </h2>
                    <p class="mt-4 text-sm text-zinc-500 max-w-md mx-auto">Every project is different. Tell us what you're building and we'll put together a tailored proposal.</p>
                    <div class="mt-8">
                        <a href="<%= contact_path %>" class="group inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-amber-500 text-zinc-950 text-sm font-bold hover:bg-amber-400 transition-all shadow-[0_0_24px_rgba(251,191,36,0.3)]">
                            Get a quote <i class='bx bx-right-arrow-alt text-base transition-transform group-hover:translate-x-1'></i>
                        </a>
                    </div>
                </div>

            </div>
        </section>
    </main>

    <%= render 'landing/footer' %>
    <%= javascript_include_tag "landing" %>
    <%= render 'layouts/toast' %>
</body>
</html>
