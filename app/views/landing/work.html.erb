<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet">
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <%= render "layouts/theme" %>
    <link rel="icon" type="image/png" href="<%= brand_favicon_url %>">
    <title>Work — XBolt Media</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        body { font-family: 'Inter', system-ui, sans-serif; background: #09090b; }
        [data-anim] { opacity: 0; transform: translateY(36px); transition: opacity 0.85s cubic-bezier(0.16,1,0.3,1), transform 0.85s cubic-bezier(0.16,1,0.3,1); }
        [data-anim].is-visible { opacity: 1; transform: translateY(0); }
        .xb-grad-amber { background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 50%, #d97706 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
        .xb-grad-white { background: linear-gradient(180deg, #fff 0%, rgba(255,255,255,0.6) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
        .xb-project {
            transition: border-color 0.4s ease, box-shadow 0.5s ease, transform 0.5s cubic-bezier(0.16,1,0.3,1);
            background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06);
        }
        .xb-project:hover { border-color: rgba(251,191,36,0.2); box-shadow: 0 24px 48px -16px rgba(0,0,0,0.5), 0 0 0 1px rgba(251,191,36,0.06); transform: translateY(-4px); }
        .xb-project:hover .xb-img { transform: scale(1.05); }
        .xb-img { transition: transform 0.7s cubic-bezier(0.16,1,0.3,1); }
        .xb-sep { height: 1px; background: linear-gradient(90deg, transparent, rgba(251,191,36,0.12) 50%, transparent); }
        @media (prefers-reduced-motion: reduce) { [data-anim] { opacity: 1 !important; transform: none !important; transition: none !important; } .xb-project:hover { transform: none !important; } .xb-project:hover .xb-img { transform: none !important; } }
    </style>
</head>
<body class="text-white antialiased overflow-x-hidden">
    <%= render 'landing/navbar' %>

    <main>
        <section class="pt-36 sm:pt-44 pb-20" style="background: #09090b;">
            <div class="container mx-auto px-4 sm:px-6 lg:px-8">
                <div class="max-w-3xl mx-auto text-center mb-16" data-anim>
                    <div class="inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.2em] font-semibold text-amber-500/70 mb-4">
                        <span class="w-5 h-px bg-amber-500/40"></span> Portfolio <span class="w-5 h-px bg-amber-500/40"></span>
                    </div>
                    <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-[-0.04em] xb-grad-white">Our Work</h1>
                    <p class="mt-5 text-base sm:text-lg text-zinc-500 max-w-lg mx-auto">Live projects we've designed, built, and deployed.</p>
                </div>

                <% if @tenant_businesses.any? || @work_cards.any? %>
                    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 max-w-6xl mx-auto">
                        <% @tenant_businesses.each_with_index do |b, i| %>
                            <% host = b.custom_domain.presence || b.full_subdomain %>
                            <a href="<%= "https://#{host}" %>" target="_blank" rel="noopener" class="xb-project group rounded-2xl overflow-hidden block" data-anim style="transition-delay: <%= (i * 0.06).round(2) %>s;">
                                <div class="relative overflow-hidden">
                                    <% if b.image_url.present? %>
                                        <img src="<%= b.image_url %>" alt="<%= b.name %>" class="xb-img w-full h-48 object-cover">
                                    <% else %>
                                        <div class="xb-img w-full h-48 bg-gradient-to-br from-zinc-800 to-zinc-900 flex items-center justify-center">
                                            <div class="w-12 h-12 rounded-2xl bg-amber-500/10 flex items-center justify-center"><i class='bx bx-briefcase text-xl text-amber-400/40'></i></div>
                                        </div>
                                    <% end %>
                                </div>
                                <div class="p-5">
                                    <div class="flex items-start justify-between gap-3">
                                        <div class="min-w-0 flex-1">
                                            <h3 class="text-base font-semibold text-white truncate"><%= b.name %></h3>
                                            <div class="text-[11px] text-zinc-600 font-mono mt-0.5 truncate"><%= host %></div>
                                        </div>
                                        <div class="w-7 h-7 rounded-md border border-white/[0.08] flex items-center justify-center text-zinc-600 group-hover:text-amber-400 group-hover:border-amber-500/20 transition flex-shrink-0">
                                            <i class='bx bx-link-external text-xs'></i>
                                        </div>
                                    </div>
                                    <% if b.description.present? %>
                                        <p class="text-sm text-zinc-500 mt-3 leading-relaxed line-clamp-2"><%= b.description %></p>
                                    <% end %>
                                </div>
                            </a>
                        <% end %>

                        <% @work_cards.each_with_index do |card, i| %>
                            <% display_domain = card.domain_url.to_s.sub(%r{\Ahttps?://}i, "").delete_suffix("/") %>
                            <a href="<%= card.domain_url %>" target="_blank" rel="noopener" class="xb-project group rounded-2xl overflow-hidden block" data-anim style="transition-delay: <%= ((@tenant_businesses.size + i) * 0.06).round(2) %>s;">
                                <div class="relative overflow-hidden">
                                    <% if card.image_url.present? %>
                                        <img src="<%= card.image_url %>" alt="<%= card.name %>" class="xb-img w-full h-48 object-cover">
                                    <% else %>
                                        <div class="xb-img w-full h-48 bg-gradient-to-br from-zinc-800 to-zinc-900 flex items-center justify-center">
                                            <div class="w-12 h-12 rounded-2xl bg-amber-500/10 flex items-center justify-center"><i class='bx bx-world text-xl text-amber-400/40'></i></div>
                                        </div>
                                    <% end %>
                                </div>
                                <div class="p-5">
                                    <div class="flex items-start justify-between gap-3">
                                        <div class="min-w-0 flex-1">
                                            <h3 class="text-base font-semibold text-white truncate"><%= card.name %></h3>
                                            <div class="text-[11px] text-zinc-600 font-mono mt-0.5 truncate"><%= display_domain %></div>
                                        </div>
                                        <div class="w-7 h-7 rounded-md border border-white/[0.08] flex items-center justify-center text-zinc-600 group-hover:text-amber-400 group-hover:border-amber-500/20 transition flex-shrink-0">
                                            <i class='bx bx-link-external text-xs'></i>
                                        </div>
                                    </div>
                                    <% if card.description.present? %>
                                        <p class="text-sm text-zinc-500 mt-3 leading-relaxed line-clamp-2"><%= card.description %></p>
                                    <% end %>
                                </div>
                            </a>
                        <% end %>
                    </div>
                <% else %>
                    <div class="max-w-md mx-auto text-center py-16" data-anim>
                        <div class="w-12 h-12 rounded-2xl bg-amber-500/10 border border-amber-500/10 flex items-center justify-center mx-auto mb-4">
                            <i class='bx bx-folder-open text-xl text-amber-400'></i>
                        </div>
                        <h2 class="text-lg font-semibold text-white mb-2">No projects yet</h2>
                        <p class="text-sm text-zinc-500">We're working on some exciting things. Check back soon.</p>
                    </div>
                <% end %>

                <div class="xb-sep mt-24 mb-0"></div>

                <div class="max-w-2xl mx-auto text-center mt-20" data-anim>
                    <h2 class="text-2xl sm:text-3xl font-bold tracking-[-0.02em]">
                        <span class="xb-grad-white">Want to be</span> <span class="xb-grad-amber">next?</span>
                    </h2>
                    <p class="mt-4 text-sm text-zinc-500 max-w-md mx-auto">Tell us what you're building. We'll ship a premium site that converts.</p>
                    <div class="mt-8">
                        <a href="<%= contact_path %>" class="group inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-amber-500 text-zinc-950 text-sm font-bold hover:bg-amber-400 transition-all shadow-[0_0_24px_rgba(251,191,36,0.3)]">
                            Start a project <i class='bx bx-right-arrow-alt text-base transition-transform group-hover:translate-x-1'></i>
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <%= render 'landing/footer' %>
    <%= javascript_include_tag "landing" %>
    <%= render 'layouts/toast' %>
</body>
</html>
