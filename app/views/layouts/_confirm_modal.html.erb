<div id="confirm-modal" class="fixed inset-0 z-[9999] hidden pointer-events-none" aria-hidden="true">
  <div id="confirm-backdrop" class="absolute inset-0 bg-black/40 backdrop-blur-sm transition-opacity duration-200 opacity-0 pointer-events-none"></div>

  <div class="flex items-center justify-center min-h-full p-4">
    <div id="confirm-dialog" class="relative bg-white rounded-2xl shadow-2xl border border-zinc-200 w-full max-w-sm p-6 transform scale-95 opacity-0 transition-all duration-200 pointer-events-auto">
      <div class="flex items-center justify-center w-12 h-12 rounded-xl bg-red-50 border border-red-100 mx-auto mb-4">
        <i class='bx bx-error text-red-600 text-2xl'></i>
      </div>

      <h3 id="confirm-title" class="text-lg font-semibold text-zinc-950 text-center">Are you sure?</h3>
      <p id="confirm-message" class="text-sm text-zinc-600 text-center mt-2 leading-relaxed"></p>

      <div class="flex gap-3 mt-6">
        <button id="confirm-cancel" type="button" class="flex-1 px-4 py-2.5 rounded-xl border border-zinc-200 text-zinc-700 font-semibold text-sm hover:bg-zinc-50 transition-colors">
          Cancel
        </button>
        <button id="confirm-accept" type="button" class="flex-1 px-4 py-2.5 rounded-xl bg-red-600 text-white font-semibold text-sm hover:bg-red-700 transition-colors">
          Confirm
        </button>
      </div>
    </div>
  </div>
</div>
