<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= @general_setting&.application_name || 'XBolt' %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta charset="utf-8">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

    <%= render "layouts/theme" %>
    <link rel="icon" type="image/png" href="<%= brand_favicon_url %>">
  </head>

  <body class="bg-zinc-50 text-zinc-900 font-sans antialiased">
    <div class="min-h-screen flex items-center justify-center p-6">
      <%= yield %>
    </div>

    <%= render 'layouts/toast' if defined?(render) %>
  </body>
</html>

