<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <title><%= content_for?(:page_title) ? yield(:page_title) : "Website Editor" %> · XBolt</title>
  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
  <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
  <style>
    :root {
      --xb-chrome-bg: #09090b;
      --xb-chrome-panel: #111113;
      --xb-chrome-elevated: #18181b;
      --xb-chrome-border: rgba(255,255,255,0.10);
      --xb-chrome-text: #fafafa;
      --xb-chrome-muted: #a1a1aa;
      --xb-chrome-faint: #71717a;
      --xb-chrome-accent: #fbbf24;
      --xb-chrome-accent-text: #09090b;
      --xb-chrome-danger: #f87171;
      --xb-chrome-ok: #34d399;
      --xb-chrome-saving: #fcd34d;
      --xb-chrome-radius: 12px;
      --xb-chrome-font: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
    }

    html, body {
      height: 100%;
      margin: 0;
      overflow: hidden;
      background: var(--xb-chrome-bg);
      color: var(--xb-chrome-text);
      font-family: var(--xb-chrome-font);
    }

    .xb-editor {
      display: flex;
      height: 100vh;
      width: 100vw;
      overflow: hidden;
      background: var(--xb-chrome-bg);
      color: var(--xb-chrome-text);
    }

    /* ── Icon rail ── */
    .xb-editor-rail {
      width: 56px;
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      padding: 12px 0;
      background: var(--xb-chrome-bg);
      border-right: 1px solid var(--xb-chrome-border);
      z-index: 40;
      position: relative;
      overflow: visible;
    }

    .xb-rail-btn {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border: 0;
      border-radius: 10px;
      background: transparent;
      color: var(--xb-chrome-muted);
      cursor: pointer;
      text-decoration: none;
      transition: background-color .15s ease, color .15s ease, transform .12s ease;
    }
    .xb-rail-btn:hover { background: rgba(255,255,255,0.08); color: var(--xb-chrome-text); }
    .xb-rail-btn:active { transform: scale(0.96); }
    .xb-rail-btn.is-active { background: rgba(251,191,36,0.15); color: var(--xb-chrome-accent); }
    .xb-rail-btn-danger:hover { background: rgba(248,113,113,0.14); color: var(--xb-chrome-danger); }
    .xb-rail-divider { width: 28px; height: 1px; margin: 6px 0; background: var(--xb-chrome-border); }

    /* Hover tip pills */
    .xb-rail-btn[data-tip]::after {
      content: attr(data-tip);
      position: absolute;
      left: calc(100% + 10px);
      top: 50%;
      transform: translateY(-50%) translateX(-2px);
      padding: 5px 10px;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,0.1);
      background: rgba(24,24,27,0.96);
      color: var(--xb-chrome-text);
      font-size: 11px;
      font-weight: 550;
      letter-spacing: 0.01em;
      line-height: 1.2;
      white-space: nowrap;
      opacity: 0;
      pointer-events: none;
      box-shadow: 0 6px 18px rgba(0,0,0,0.35);
      transition: opacity .12s ease, transform .12s ease;
      z-index: 90;
    }
    .xb-rail-btn[data-tip]:hover::after,
    .xb-rail-btn[data-tip]:focus-visible::after {
      opacity: 1;
      transform: translateY(-50%) translateX(0);
    }
    .xb-rail-tip-wrap {
      position: relative;
      display: inline-flex;
    }
    .xb-rail-tip-wrap > .xb-rail-btn[data-tip]::after {
      /* keep tips above the pages menu / rail */
      z-index: 95;
    }

    /* ── Pages popover ── */
    .xb-page-menu {
      position: fixed;
      left: 64px;
      top: 56px;
      width: 240px;
      max-height: min(70vh, 420px);
      overflow: auto;
      padding: 8px;
      border-radius: var(--xb-chrome-radius);
      border: 1px solid var(--xb-chrome-border);
      background: var(--xb-chrome-panel);
      box-shadow: 0 18px 40px rgba(0,0,0,0.45);
      z-index: 80;
      color: var(--xb-chrome-text);
    }
    .xb-page-menu[hidden] { display: none !important; }
    .xb-page-menu-label {
      padding: 6px 10px 8px;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--xb-chrome-faint);
    }
    .xb-page-link {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 9px 10px;
      border-radius: 8px;
      color: var(--xb-chrome-muted);
      text-decoration: none;
      font-size: 12px;
      font-weight: 550;
    }
    .xb-page-link:hover { background: rgba(255,255,255,0.06); color: var(--xb-chrome-text); }
    .xb-page-link.is-current { background: rgba(251,191,36,0.14); color: var(--xb-chrome-accent); }

    /* ── Inspector panel (never overlays / never clips) ── */
    .xb-inspector-panel {
      width: 0;
      flex-shrink: 0;
      overflow: hidden;
      background: var(--xb-chrome-panel);
      border-right: 1px solid transparent;
      transition: width .18s ease, border-color .18s ease;
      color: var(--xb-chrome-text);
    }
    .xb-inspector-panel.is-open {
      width: 320px;
      border-right-color: var(--xb-chrome-border);
    }
    .xb-inspector-inner {
      width: 320px;
      height: 100%;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .xb-inspector-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
      padding: 16px 16px 12px;
      border-bottom: 1px solid var(--xb-chrome-border);
      flex-shrink: 0;
    }
    .xb-inspector-kicker {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--xb-chrome-faint);
      margin: 0 0 4px;
    }
    .xb-inspector-title {
      margin: 0;
      font-size: 14px;
      font-weight: 650;
      color: var(--xb-chrome-text);
      line-height: 1.3;
      word-break: break-word;
    }
    .xb-inspector-body {
      flex: 1;
      overflow: auto;
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .xb-inspector-input,
    .xb-inspector-input:disabled {
      width: 100%;
      min-height: 140px;
      resize: vertical;
      box-sizing: border-box;
      border: 1px solid var(--xb-chrome-border);
      border-radius: var(--xb-chrome-radius);
      background: var(--xb-chrome-elevated) !important;
      color: var(--xb-chrome-text) !important;
      caret-color: var(--xb-chrome-accent);
      font: 13px/1.55 var(--xb-chrome-font);
      padding: 12px 14px;
      outline: none;
      -webkit-text-fill-color: var(--xb-chrome-text);
    }
    .xb-inspector-input::placeholder {
      color: var(--xb-chrome-faint);
      -webkit-text-fill-color: var(--xb-chrome-faint);
      opacity: 1;
    }
    .xb-inspector-input:focus {
      border-color: rgba(251,191,36,0.55);
      box-shadow: 0 0 0 3px rgba(251,191,36,0.16);
    }
    .xb-inspector-input:disabled {
      opacity: 0.55;
      cursor: default;
    }
    .xb-inspector-hint {
      border: 1px solid rgba(251,191,36,0.22);
      background: rgba(251,191,36,0.08);
      color: #fde68a;
      border-radius: 10px;
      padding: 10px 12px;
      font-size: 11px;
      line-height: 1.45;
    }
    .xb-inspector-hint[hidden] { display: none !important; }
    .xb-inspector-actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-top: auto;
      padding-top: 4px;
    }
    .xb-btn {
      appearance: none;
      border: 0;
      border-radius: 10px;
      padding: 9px 14px;
      font: 600 12px/1 var(--xb-chrome-font);
      cursor: pointer;
      transition: background-color .15s ease, color .15s ease;
    }
    .xb-btn-ghost {
      background: transparent;
      color: var(--xb-chrome-muted);
    }
    .xb-btn-ghost:hover { background: rgba(255,255,255,0.08); color: var(--xb-chrome-text); }
    .xb-btn-primary {
      background: var(--xb-chrome-accent);
      color: var(--xb-chrome-accent-text);
    }
    .xb-btn-primary:hover { filter: brightness(1.05); }
    .xb-icon-btn {
      appearance: none;
      border: 0;
      background: transparent;
      color: var(--xb-chrome-muted);
      border-radius: 8px;
      padding: 6px;
      cursor: pointer;
    }
    .xb-icon-btn:hover { background: rgba(255,255,255,0.08); color: var(--xb-chrome-text); }

    .xb-canvas {
      position: relative;
      flex: 1;
      min-width: 0;
      background: #fff;
    }
    .xb-canvas iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
      background: #fff;
    }

    /* Floating chrome over the live preview */
    .xb-float-badge {
      position: absolute;
      z-index: 25;
      left: 14px;
      bottom: 14px;
      padding: 3px 8px;
      border-radius: 4px;
      border: 1px solid rgba(255,255,255,0.1);
      background: rgba(9,9,11,0.55);
      color: var(--xb-chrome-faint);
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 0.04em;
      line-height: 1.2;
      pointer-events: none;
      user-select: none;
    }

    .xb-status-toast {
      position: absolute;
      z-index: 25;
      right: 16px;
      bottom: 16px;
      max-width: min(360px, calc(100% - 32px));
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 10px 14px;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,0.12);
      background: rgba(9,9,11,0.88);
      color: var(--xb-chrome-text);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      box-shadow: 0 10px 28px rgba(0,0,0,0.28);
      pointer-events: auto;
      user-select: none;
      transition: border-color .15s ease, box-shadow .15s ease, transform .15s ease;
    }
    .xb-status-toast-dot {
      width: 8px;
      height: 8px;
      border-radius: 999px;
      background: var(--xb-chrome-faint);
      flex-shrink: 0;
      box-shadow: 0 0 0 3px rgba(255,255,255,0.06);
    }
    .xb-status-toast-text {
      font-size: 12px;
      font-weight: 600;
      line-height: 1.3;
      color: var(--xb-chrome-text);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .xb-status-toast.is-ok { border-color: rgba(52,211,153,0.28); }
    .xb-status-toast.is-ok .xb-status-toast-dot {
      background: var(--xb-chrome-ok);
      box-shadow: 0 0 0 3px rgba(52,211,153,0.16);
    }
    .xb-status-toast.is-saving { border-color: rgba(252,211,77,0.28); }
    .xb-status-toast.is-saving .xb-status-toast-dot {
      background: var(--xb-chrome-saving);
      box-shadow: 0 0 0 3px rgba(252,211,77,0.16);
      animation: xb-status-pulse 1s ease-in-out infinite;
    }
    .xb-status-toast.is-error { border-color: rgba(248,113,113,0.32); }
    .xb-status-toast.is-error .xb-status-toast-dot {
      background: var(--xb-chrome-danger);
      box-shadow: 0 0 0 3px rgba(248,113,113,0.16);
    }
    @keyframes xb-status-pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.55; transform: scale(0.85); }
    }

    .xb-empty {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 32px;
      text-align: center;
    }

    @media (prefers-reduced-motion: reduce) {
      .xb-inspector-panel,
      .xb-rail-btn,
      .xb-rail-btn[data-tip]::after,
      .xb-status-toast { transition: none; }
      .xb-rail-btn:active { transform: none; }
      .xb-status-toast.is-saving .xb-status-toast-dot { animation: none; }
    }
  </style>
</head>
<body data-turbo="false">
  <%= yield %>
</body>
</html>
