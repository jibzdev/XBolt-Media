<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= @business.name %> | Under construction</title>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= render "layouts/theme" %>
    <link rel="icon" type="image/png" href="<%= brand_favicon_url %>">
  </head>
  <body class="min-h-screen bg-white text-zinc-900 flex items-center justify-center p-5">
    <div class="max-w-md w-full text-center">
      <div class="inline-flex items-center justify-center w-11 h-11 rounded-xl bg-zinc-900 text-white mb-5">
        <span class="text-[15px] font-black tracking-tight">XB</span>
      </div>

      <h1 class="text-[20px] font-semibold tracking-tight text-zinc-800 mb-2"><%= @business.name %></h1>
      <p class="text-[13px] text-zinc-500 mb-5">
        This website is currently under construction.
      </p>

      <div class="border border-zinc-200/70 rounded-xl p-4 bg-zinc-50 text-left">
        <div class="text-[10px] text-zinc-400 uppercase tracking-wider font-medium mb-1.5">Tenant</div>
        <div class="font-mono text-[12px] break-all text-zinc-700"><%= @business.full_subdomain %></div>
      </div>
    </div>
  </body>
</html>
